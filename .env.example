# Kopioi tiedosto nimelle .env paikallista kehitystä varten.
# Tuotannossa samat muuttujat asetetaan Netlifyn asetuksissa. Älä lisää oikeita avaimia repoon.

# Tyylitestin sähköpostityökalu: none, mailerlite tai brevo.
# Arvolla none tietoja ei viedä työkaluun. Vastaukset tallentuvat silti Netlify Formsiin.
EMAIL_PROVIDER=none

# MailerLite (EMAIL_PROVIDER=mailerlite)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Brevo (EMAIL_PROVIDER=brevo)
BREVO_API_KEY=
BREVO_LIST_ID=
