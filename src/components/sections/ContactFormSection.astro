---
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'

const {
  heading,
  introText,
  formName = 'contact',
  submitLabel = 'Lähetä',
  successMessage = 'Kiitos viestistä! Palaan sinulle pian.',
  fields = [],
} = Astro.props as {
  heading?: string
  introText?: string
  formName?: string
  submitLabel?: string
  successMessage?: string
  fields?: Array<{
    fieldType?: 'text' | 'email' | 'tel' | 'textarea' | 'radio' | 'checkboxGroup' | 'checkbox' | 'file'
    name?: string
    label?: string
    linkLabel?: string
    linkHref?: string
    consentContent?: PortableTextBlock[]
    placeholder?: string
    required?: boolean
    width?: 'half' | 'full'
    rows?: number
    options?: string[]
  }>
}

const safeFormName = formName.trim() || 'contact'
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY?.trim() || ''
const hasRecaptchaV3 = Boolean(recaptchaSiteKey)

const defaultFields = [
  {fieldType: 'text', name: 'firstName', label: 'Etunimi*', required: true, width: 'half'},
  {fieldType: 'text', name: 'lastName', label: 'Sukunimi*', required: true, width: 'half'},
  {fieldType: 'email', name: 'email', label: 'Sähköposti*', required: true, width: 'half'},
  {fieldType: 'text', name: 'company', label: 'Yritys', required: false, width: 'half'},
  {fieldType: 'tel', name: 'phone', label: 'Puhelinnumero', required: false, width: 'half'},
  {
    fieldType: 'checkboxGroup',
    name: 'interestedIn',
    label: 'Olet kiinnostunut?',
    required: false,
    width: 'full',
    options: ['Verkkosivut', 'Some', 'Digitaalinen kutsukortti', 'Jotain muuta'],
  },
  {fieldType: 'textarea', name: 'description', label: 'Kuvaus', required: false, width: 'full', rows: 6},
  {
    fieldType: 'file',
    name: 'attachment',
    label: 'Tarjouspyyntö tai muu dokumentti',
    required: false,
    width: 'full',
  },
  {
    fieldType: 'checkboxGroup',
    name: 'preferredContact',
    label: 'Toivottu tapa yhteydenottoon',
    required: false,
    width: 'full',
    options: ['Sähköposti', 'Puhelin', 'WhatsApp', 'Tapaaminen'],
  },
  {fieldType: 'textarea', name: 'message', label: 'Lisätiedot', required: false, width: 'full', rows: 6},
  {
    fieldType: 'checkbox',
    name: 'consent',
    label: 'Hyväksyn, että tietojani käytetään',
    linkLabel: 'tietosuojaselosteen',
    linkHref: '/tietosuojaseloste',
    required: true,
    width: 'full',
  },
]

const normalizeCmsHref = (href?: string) => {
  if (!href) return '#'
  if (
    href.startsWith('/') ||
    href.startsWith('http://') ||
    href.startsWith('https://') ||
    href.startsWith('mailto:') ||
    href.startsWith('tel:') ||
    href.startsWith('#')
  ) {
    return href
  }

  return `/${href}`
}

const normalizedFields = (Array.isArray(fields) && fields.length > 0 ? fields : defaultFields)
  .map((field, index) => {
    const fieldName = field.name?.trim() || `field-${index}`
    const fieldLabel = field.label?.trim() || fieldName
    const fieldType = field.fieldType || 'text'
    const width = field.width === 'full' ? 'full' : 'half'

    return {
      ...field,
      fieldName,
      fieldLabel,
      linkLabel: field.linkLabel?.trim() || '',
      linkHref: field.linkHref?.trim() || '',
      consentContent:
        Array.isArray(field.consentContent) && field.consentContent.length > 0
          ? field.consentContent
          : undefined,
      fieldType,
      width,
      rows: typeof field.rows === 'number' && field.rows > 1 ? field.rows : 6,
      options: Array.isArray(field.options) ? field.options.filter(Boolean) : [],
    }
  })
  .filter((field) => Boolean(field.fieldName && field.fieldLabel))

const sectionHeading = heading || 'Yhteydenotto'
const sectionIntro = introText || ''
const formStatus = Astro.url.searchParams.get('form-status')
const showSuccessMessage = formStatus === 'success'
const showErrorMessage = formStatus === 'error'
---

<section class="page-section contact-form-section" aria-label={sectionHeading}>
  <div class="site-container contact-form-section__container">
    <div class="contact-form-section__intro">
      <h2>{sectionHeading}</h2>
      {sectionIntro && <p>{sectionIntro}</p>}
    </div>

    <form
      class="contact-form"
      name={safeFormName}
      method="POST"
      accept-charset="UTF-8"
      data-netlify="true"
      netlify-honeypot="bot-field"
      enctype="multipart/form-data"
      data-recaptcha-v3={hasRecaptchaV3 ? 'true' : undefined}
      data-recaptcha-site-key={hasRecaptchaV3 ? recaptchaSiteKey : undefined}
    >
      <input type="hidden" name="form-name" value={safeFormName} />
      <input class="contact-form__bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
      {hasRecaptchaV3 && <input type="hidden" name="g-recaptcha-response" data-recaptcha-response />}

      <div class="contact-form__grid contact-form__grid--builder">
        {normalizedFields.map((field, index) => {
          const fieldId = `${safeFormName}-${field.fieldName}-${index}`
          const isFullWidth = field.width === 'full'
          const fieldClassName = `contact-form__field contact-form__field--${isFullWidth ? 'full' : 'half'}`
          const requiredMark = field.required === true ? ' *' : ''

          if (field.fieldType === 'radio') {
            return (
              <fieldset class={`contact-form__fieldset ${isFullWidth ? 'contact-form__fieldset--full' : ''}`}>
                <legend>{field.fieldLabel}{requiredMark}</legend>
                <div class="contact-form__options">
                  {field.options.map((option, optionIndex) => (
                    <label class="contact-form__radio" for={`${fieldId}-${optionIndex}`}>
                      <input
                        id={`${fieldId}-${optionIndex}`}
                        type="radio"
                        name={field.fieldName}
                        value={option}
                        required={field.required === true && optionIndex === 0}
                      />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }

          if (field.fieldType === 'checkboxGroup') {
            return (
              <fieldset class={`contact-form__fieldset ${isFullWidth ? 'contact-form__fieldset--full' : ''}`}>
                <legend>{field.fieldLabel}{requiredMark}</legend>
                <div class="contact-form__options">
                  {field.options.map((option, optionIndex) => (
                    <label class="contact-form__option" for={`${fieldId}-${optionIndex}`}>
                      <input
                        id={`${fieldId}-${optionIndex}`}
                        type="checkbox"
                        name={field.fieldName}
                        value={option}
                        required={field.required === true && optionIndex === 0}
                      />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }

          if (field.fieldType === 'checkbox') {
            const hasConsentLink = Boolean(field.linkLabel && field.linkHref)
            const hasConsentRichText = Array.isArray(field.consentContent) && field.consentContent.length > 0
            return (
              <label class={`contact-form__consent ${isFullWidth ? 'contact-form__consent--full' : ''}`} for={fieldId}>
                <input id={fieldId} name={field.fieldName} type="checkbox" required={field.required === true} />
                <div class="contact-form__consent-copy">
                  {hasConsentRichText ? (
                    <PortableText value={field.consentContent} />
                  ) : (
                    <span>
                      {field.fieldLabel}{requiredMark}{' '}
                      {hasConsentLink ? (
                        <a href={normalizeCmsHref(field.linkHref)}>{field.linkLabel}</a>
                      ) : null}
                    </span>
                  )}
                </div>
              </label>
            )
          }

          if (field.fieldType === 'textarea') {
            return (
              <div class={fieldClassName}>
                <label for={fieldId}>{field.fieldLabel}{requiredMark}</label>
                <div class="contact-form__control contact-form__control--textarea">
                  <textarea
                    id={fieldId}
                    name={field.fieldName}
                    rows={field.rows}
                    placeholder={field.placeholder || undefined}
                    required={field.required === true}
                  ></textarea>
                </div>
              </div>
            )
          }

          return (
            <div class={fieldClassName}>
              <label for={fieldId}>{field.fieldLabel}{requiredMark}</label>
              <div class="contact-form__control">
                <input
                  id={fieldId}
                  name={field.fieldName}
                  type={field.fieldType}
                  placeholder={field.placeholder || undefined}
                  required={field.required === true}
                />
              </div>
            </div>
          )
        })}
      </div>

      <button class="button button--primary-accent contact-form__submit" type="submit">
        {submitLabel}
      </button>

      <p class="contact-form__status contact-form__status--success" data-form-success hidden={!showSuccessMessage}>
        {successMessage}
      </p>
      {showErrorMessage && (
        <p class="contact-form__status contact-form__status--error">
          Lomakkeen lähetys ei onnistunut. Tarkista tiedot ja yritä uudelleen.
        </p>
      )}
      <p class="contact-form__status contact-form__status--error" data-recaptcha-error hidden>
        Lomakkeen lähetys ei onnistunut. Tarkista tiedot ja yritä uudelleen.
      </p>
    </form>

    {hasRecaptchaV3 && (
      <script
        src={`https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(recaptchaSiteKey)}`}
        data-cookieconsent="ignore"
      ></script>
    )}

    {hasRecaptchaV3 && (
      <script is:inline>
        const recaptchaForms = document.querySelectorAll('form[data-recaptcha-v3="true"]')

        recaptchaForms.forEach((form) => {
          if (!(form instanceof HTMLFormElement)) return

          const siteKey = form.getAttribute('data-recaptcha-site-key')
          const responseInput = form.querySelector('[data-recaptcha-response]')
          const successNotice = form.querySelector('[data-form-success]')
          if (!siteKey || !(responseInput instanceof HTMLInputElement)) return

          let isSubmitting = false
          const recaptchaError = form.querySelector('[data-recaptcha-error]')

          form.addEventListener('submit', (event) => {
            if (isSubmitting) return
            event.preventDefault()
            if (recaptchaError instanceof HTMLElement) recaptchaError.hidden = true

            const failSubmit = (reason) => {
              if (recaptchaError instanceof HTMLElement) recaptchaError.hidden = false
              if (reason) console.warn('reCAPTCHA verification failed:', reason)
            }

            const submitWithToken = () => {
              if (!window.grecaptcha || typeof window.grecaptcha.execute !== 'function') {
                failSubmit('grecaptcha_unavailable')
                return
              }

              window.grecaptcha
                .execute(siteKey, {action: 'contact_form_submit'})
                .then(async (token) => {
                  responseInput.value = token

                  const verifyPayload = new FormData()
                  verifyPayload.append('g-recaptcha-response', token)
                  verifyPayload.append('bot-field', '')

                  const verifyResponse = await fetch('/api/contact-submit', {
                    method: 'POST',
                    body: verifyPayload,
                  })

                  if (!verifyResponse.ok) {
                    let reason = 'verify_failed'
                    try {
                      const payload = await verifyResponse.json()
                      reason = payload?.reason || reason
                    } catch {
                      reason = 'verify_failed'
                    }
                    failSubmit(reason)
                    return
                  }

                  isSubmitting = true
                  const submitPayload = new FormData(form)
                  const submitResponse = await fetch('/', {
                    method: 'POST',
                    body: submitPayload,
                  })

                  if (!submitResponse.ok) {
                    isSubmitting = false
                    failSubmit('netlify_submit_failed')
                    return
                  }

                  if (successNotice instanceof HTMLElement) {
                    successNotice.hidden = false
                    successNotice.scrollIntoView({behavior: 'smooth', block: 'nearest'})
                  }

                  form.reset()
                  responseInput.value = ''
                  isSubmitting = false
                })
                .catch(() => {
                  failSubmit('execute_failed')
                })
            }

            if (window.grecaptcha && typeof window.grecaptcha.ready === 'function') {
              window.grecaptcha.ready(submitWithToken)
              return
            }

            failSubmit()
          })
        })
      </script>
    )}
  </div>
</section>
