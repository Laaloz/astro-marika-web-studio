---
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'

const {
  heading,
  introText,
  formName = 'contact',
  submitLabel = 'Lähetä',
  successMessage = 'Kiitos viestistä! Palaan sinulle pian.',
  fields = [],
} = Astro.props as {
  heading?: string
  introText?: string
  formName?: string
  submitLabel?: string
  successMessage?: string
  fields?: Array<{
    fieldType?: 'text' | 'email' | 'tel' | 'textarea' | 'radio' | 'checkboxGroup' | 'checkbox' | 'file'
    name?: string
    label?: string
    linkLabel?: string
    linkHref?: string
    consentContent?: PortableTextBlock[]
    placeholder?: string
    required?: boolean
    width?: 'half' | 'full'
    rows?: number
    options?: string[]
  }>
}

const safeFormName = formName.trim() || 'contact'

const defaultFields = [
  {fieldType: 'text', name: 'firstName', label: 'Etunimi*', required: true, width: 'half'},
  {fieldType: 'text', name: 'lastName', label: 'Sukunimi*', required: true, width: 'half'},
  {fieldType: 'email', name: 'email', label: 'Sähköposti*', required: true, width: 'half'},
  {fieldType: 'text', name: 'company', label: 'Yritys', required: false, width: 'half'},
  {fieldType: 'tel', name: 'phone', label: 'Puhelinnumero', required: false, width: 'half'},
  {
    fieldType: 'checkboxGroup',
    name: 'interestedIn',
    label: 'Olet kiinnostunut?',
    required: false,
    width: 'full',
    options: ['Verkkosivut', 'Some', 'Digitaalinen kutsukortti', 'Jotain muuta'],
  },
  {fieldType: 'textarea', name: 'description', label: 'Kuvaus', required: false, width: 'full', rows: 6},
  {
    fieldType: 'file',
    name: 'attachment',
    label: 'Tarjouspyyntö tai muu dokumentti',
    required: false,
    width: 'full',
  },
  {
    fieldType: 'checkboxGroup',
    name: 'preferredContact',
    label: 'Toivottu tapa yhteydenottoon',
    required: false,
    width: 'full',
    options: ['Sähköposti', 'Puhelin', 'WhatsApp', 'Tapaaminen'],
  },
  {fieldType: 'textarea', name: 'message', label: 'Lisätiedot', required: false, width: 'full', rows: 6},
  {
    fieldType: 'checkbox',
    name: 'consent',
    label: 'Hyväksyn, että tietojani käytetään',
    linkLabel: 'tietosuojaselosteen',
    linkHref: '/tietosuojaseloste',
    required: true,
    width: 'full',
  },
]

const normalizeCmsHref = (href?: string) => {
  if (!href) return '#'
  if (
    href.startsWith('/') ||
    href.startsWith('http://') ||
    href.startsWith('https://') ||
    href.startsWith('mailto:') ||
    href.startsWith('tel:') ||
    href.startsWith('#')
  ) {
    return href
  }

  return `/${href}`
}

const normalizedFields = (Array.isArray(fields) && fields.length > 0 ? fields : defaultFields)
  .map((field, index) => {
    const fieldName = field.name?.trim() || `field-${index}`
    const fieldLabel = field.label?.trim() || fieldName
    const fieldType = field.fieldType || 'text'
    const width = field.width === 'full' ? 'full' : 'half'

    return {
      ...field,
      fieldName,
      fieldLabel,
      linkLabel: field.linkLabel?.trim() || '',
      linkHref: field.linkHref?.trim() || '',
      consentContent:
        Array.isArray(field.consentContent) && field.consentContent.length > 0
          ? field.consentContent
          : undefined,
      fieldType,
      width,
      rows: typeof field.rows === 'number' && field.rows > 1 ? field.rows : 6,
      options: Array.isArray(field.options) ? field.options.filter(Boolean) : [],
    }
  })
  .filter((field) => Boolean(field.fieldName && field.fieldLabel))

const checkboxGroupFieldNames = normalizedFields
  .filter((field) => field.fieldType === 'checkboxGroup')
  .map((field) => field.fieldName)

const sectionHeading = heading || 'Yhteydenotto'
const sectionIntro = introText || ''
const formStatus = Astro.url.searchParams.get('form-status')
const showSuccessMessage = formStatus === 'success'
const showErrorMessage = formStatus === 'error'
const successActionPath = `${Astro.url.pathname}?form-status=success`
---

<section class="page-section contact-form-section" aria-label={sectionHeading}>
  <div class="site-container contact-form-section__container">
    <div class="contact-form-section__intro">
      <h2>{sectionHeading}</h2>
      {sectionIntro && <p>{sectionIntro}</p>}
    </div>

    <form
      class="contact-form"
      name={safeFormName}
      method="POST"
      action={successActionPath}
      accept-charset="UTF-8"
      netlify
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value={safeFormName} />
      <input type="hidden" name="redirect" value={successActionPath} />
      <input type="hidden" name="form-source" value="contact-section" />
      <input class="contact-form__bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
      {checkboxGroupFieldNames.map((name) => (
        <input type="hidden" name={name} value="" data-checkbox-group-target={name} />
      ))}

      <div class="contact-form__status contact-form__status--success" data-form-success hidden={!showSuccessMessage}>
        {successMessage}
      </div>

      <div class="contact-form__status contact-form__status--error" data-form-error hidden={!showErrorMessage}>
        Lomakkeen lähetys ei onnistunut. Tarkista tiedot ja yritä uudelleen.
      </div>

      <div data-form-fields hidden={showSuccessMessage}>
      <div class="contact-form__grid contact-form__grid--builder">
        {normalizedFields.map((field, index) => {
          const fieldId = `${safeFormName}-${field.fieldName}-${index}`
          const isFullWidth = field.width === 'full'
          const fieldClassName = `contact-form__field contact-form__field--${isFullWidth ? 'full' : 'half'}`
          const requiredMark = field.required === true ? ' *' : ''

          if (field.fieldType === 'radio') {
            return (
              <fieldset class={`contact-form__fieldset ${isFullWidth ? 'contact-form__fieldset--full' : ''}`}>
                <legend>{field.fieldLabel}{requiredMark}</legend>
                <div class="contact-form__options">
                  {field.options.map((option, optionIndex) => (
                    <label class="contact-form__radio" for={`${fieldId}-${optionIndex}`}>
                      <input
                        id={`${fieldId}-${optionIndex}`}
                        type="radio"
                        name={field.fieldName}
                        value={option}
                        required={field.required === true && optionIndex === 0}
                      />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }

          if (field.fieldType === 'checkboxGroup') {
            return (
              <fieldset class={`contact-form__fieldset ${isFullWidth ? 'contact-form__fieldset--full' : ''}`}>
                <legend>{field.fieldLabel}{requiredMark}</legend>
                <div class="contact-form__options">
                  {field.options.map((option, optionIndex) => (
                    <label class="contact-form__option" for={`${fieldId}-${optionIndex}`}>
                      <input
                        id={`${fieldId}-${optionIndex}`}
                        type="checkbox"
                        name={`${field.fieldName}[]`}
                        data-checkbox-group-option={field.fieldName}
                        value={option}
                        required={field.required === true && optionIndex === 0}
                      />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }

          if (field.fieldType === 'checkbox') {
            const hasConsentLink = Boolean(field.linkLabel && field.linkHref)
            const hasConsentRichText = Array.isArray(field.consentContent) && field.consentContent.length > 0
            return (
              <label class={`contact-form__consent ${isFullWidth ? 'contact-form__consent--full' : ''}`} for={fieldId}>
                <input id={fieldId} name={field.fieldName} type="checkbox" required={field.required === true} />
                <div class="contact-form__consent-copy">
                  {hasConsentRichText ? (
                    <PortableText value={field.consentContent} />
                  ) : (
                    <span>
                      {field.fieldLabel}{requiredMark}{' '}
                      {hasConsentLink ? (
                        <a href={normalizeCmsHref(field.linkHref)}>{field.linkLabel}</a>
                      ) : null}
                    </span>
                  )}
                </div>
              </label>
            )
          }

          if (field.fieldType === 'textarea') {
            return (
              <div class={fieldClassName}>
                <label for={fieldId}>{field.fieldLabel}{requiredMark}</label>
                <div class="contact-form__control contact-form__control--textarea">
                  <textarea
                    id={fieldId}
                    name={field.fieldName}
                    rows={field.rows}
                    placeholder={field.placeholder || undefined}
                    required={field.required === true}
                  ></textarea>
                </div>
              </div>
            )
          }

          return (
            <div class={fieldClassName}>
              <label for={fieldId}>{field.fieldLabel}{requiredMark}</label>
              <div class="contact-form__control">
                <input
                  id={fieldId}
                  name={field.fieldName}
                  type={field.fieldType}
                  placeholder={field.placeholder || undefined}
                  required={field.required === true}
                />
              </div>
            </div>
          )
        })}
      </div>

      <div data-netlify-recaptcha="true"></div>

      <button class="button button--primary-accent contact-form__submit" type="submit" data-submit-button>
        <span data-submit-label>{submitLabel}</span>
        <span class="contact-form__submit-spinner" aria-hidden="true"></span>
      </button>
      </div>
    </form>

    <script is:inline>
      const contactForms = document.querySelectorAll('.contact-form[data-netlify="true"]')

      contactForms.forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return
        const submitButton = form.querySelector('[data-submit-button]')
        const submitLabel = form.querySelector('[data-submit-label]')
        const successNotice = form.querySelector('[data-form-success]')
        const errorNotice = form.querySelector('[data-form-error]')
        const formFields = form.querySelector('[data-form-fields]')
        if (!(submitButton instanceof HTMLButtonElement) || !(submitLabel instanceof HTMLElement)) return

        const defaultText = submitLabel.textContent || 'Lähetä'
        const successFlagKey = `form-success:${form.getAttribute('name') || 'contact'}:${window.location.pathname}`

        const syncCheckboxGroups = () => {
          const groups = new Map()
          const checkedInputs = form.querySelectorAll('input[type="checkbox"][data-checkbox-group-option]:checked')
          checkedInputs.forEach((input) => {
            if (!(input instanceof HTMLInputElement)) return
            const groupName = input.getAttribute('data-checkbox-group-option')
            if (!groupName) return
            const current = groups.get(groupName) || []
            current.push(input.value)
            groups.set(groupName, current)
          })

          const hiddenGroupTargets = form.querySelectorAll('input[type="hidden"][data-checkbox-group-target]')
          hiddenGroupTargets.forEach((input) => {
            if (!(input instanceof HTMLInputElement)) return
            const key = input.getAttribute('data-checkbox-group-target') || ''
            const values = groups.get(key)
            input.value = Array.isArray(values) ? values.join(', ') : ''
          })
        }

        const disableRawCheckboxGroupInputs = () => {
          const rawGroupInputs = form.querySelectorAll('input[type="checkbox"][data-checkbox-group-option]')
          rawGroupInputs.forEach((input) => {
            if (!(input instanceof HTMLInputElement)) return
            input.disabled = true
          })
        }

        if (window.sessionStorage.getItem(successFlagKey) === '1') {
          if (successNotice instanceof HTMLElement) successNotice.hidden = false
          if (errorNotice instanceof HTMLElement) errorNotice.hidden = true
          if (formFields instanceof HTMLElement) formFields.hidden = true
          window.sessionStorage.removeItem(successFlagKey)
        }

        const setLoadingState = () => {
          submitButton.disabled = true
          submitButton.classList.add('is-loading')
          submitButton.setAttribute('aria-busy', 'true')
          submitLabel.textContent = 'Lähetetään...'
        }

        form.addEventListener('submit', () => {
          syncCheckboxGroups()
          disableRawCheckboxGroupInputs()
          window.sessionStorage.setItem(successFlagKey, '1')
          setLoadingState()
        })

        window.addEventListener('pageshow', () => {
          submitButton.disabled = false
          submitButton.classList.remove('is-loading')
          submitButton.removeAttribute('aria-busy')
          submitLabel.textContent = defaultText
        })
      })

      if (window.location.search.includes('form-status=success')) {
        const successStatus = document.querySelector('[data-form-success]')
        const formFields = document.querySelector('[data-form-fields]')
        if (successStatus instanceof HTMLElement) {
          successStatus.hidden = false
          if (formFields instanceof HTMLElement) formFields.hidden = true
          requestAnimationFrame(() => {
            successStatus.scrollIntoView({behavior: 'smooth', block: 'center'})
          })
        }
      }
    </script>
  </div>
</section>
