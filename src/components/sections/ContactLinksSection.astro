---
interface LinkItem {
  _key?: string
  label?: string
  href?: string
}

const {message, links = []} = Astro.props as {
  message?: string
  links?: LinkItem[]
}

const hasMessage = Boolean(typeof message === 'string' && message.trim())
const linksList = links.filter((item) => item?.label && item?.href)
const hasContent = Boolean(hasMessage || linksList.length > 0)
---

{
  hasContent && (
    <section
      class:list={{
        'page-section contact-links-section': true,
        'contact-links-section--right-only': linksList.length > 0 && !hasMessage,
      }}
      aria-label="Contact links section"
    >
      <div class="site-container contact-links-section__container">
        <div class="contact-links-section__layout">
          {hasMessage && <p class="contact-links-section__message">{message}</p>}

          {linksList.length > 0 && (
            <div class="contact-links-section__links" role="navigation" aria-label="Quick links">
              {linksList.map((item) => (
                <a class="contact-links-section__link reference-section__cta button--link-secondary" href={item.href}>
                  <span>{item.label}</span>
                  <svg class="button__arrow" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12H17" />
                    <path d="M12 7L17 12L12 17" />
                  </svg>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
