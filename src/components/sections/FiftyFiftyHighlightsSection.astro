---
import {PortableText} from 'astro-portabletext';
import type {PortableTextBlock} from '@portabletext/types';
import SanityImage from '../SanityImage.astro';

type HighlightItem = {
  title?: string;
  subtitle?: string;
  body?: PortableTextBlock[];
  note?: string;
  variant?: 'cta' | 'accordion';
  accordionTitle?: string;
  accordionBody?: PortableTextBlock[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSide?: 'left' | 'right';
  image?: {
    alt?: string;
  };
};

const {eyebrow, heading, items = []} = Astro.props as {eyebrow?: string; heading?: string; items?: HighlightItem[]};
const rows = items.filter((item) => {
  if (!item?.title || !Array.isArray(item.body) || item.body.length === 0 || !item?.image) {
    return false;
  }

  if (item.variant === 'accordion') {
    return Boolean(item?.accordionTitle) && Array.isArray(item.accordionBody) && item.accordionBody.length > 0;
  }

  return Boolean(item?.ctaLabel && item?.ctaHref);
});
const eyebrowText = typeof eyebrow === 'string' ? eyebrow.trim() : '';
const headingText = typeof heading === 'string' ? heading.trim() : '';
---

{
  rows.length > 0 && (
    <section class="page-section fifty-fifty-highlights" aria-label="Content highlights">
      <div class="site-container fifty-fifty-highlights__container">
        {(eyebrowText || headingText) && (
          <div class="fifty-fifty-highlights__intro">
            {eyebrowText && (
              <div class="fifty-fifty-highlights__eyebrow-wrap">
                <span class="fifty-fifty-highlights__eyebrow-dot" aria-hidden="true"></span>
                <p class="fifty-fifty-highlights__eyebrow">{eyebrowText}</p>
              </div>
            )}
            {headingText && <h2 class="fifty-fifty-highlights__section-title">{headingText}</h2>}
          </div>
        )}
        <div class="fifty-fifty-highlights__rows">
        {rows.map((item, index) => {
          const imageOnLeft = item.imageSide === 'left';
          const isAccordion = item.variant === 'accordion';
          return (
            <article class:list={{ 'fifty-fifty-highlights__row': true, 'fifty-fifty-highlights__row--image-left': imageOnLeft }}>
              <div class="fifty-fifty-highlights__content">
                <div class="fifty-fifty-highlights__copy">
                  <h2 class="fifty-fifty-highlights__title">{item.title}</h2>
                  {isAccordion && item.subtitle && <p class="fifty-fifty-highlights__subtitle">{item.subtitle}</p>}
                  <div class="fifty-fifty-highlights__body rich-text">
                    <PortableText value={item.body} />
                  </div>
                  <div class="fifty-fifty-highlights__divider"></div>
                  {item.note && (
                    <p class:list={{ 'fifty-fifty-highlights__note': true, 'fifty-fifty-highlights__note--accordion': isAccordion }}>
                      {item.note}
                    </p>
                  )}
                </div>
                {
                  isAccordion ? (
                    <details class="fifty-fifty-highlights__accordion">
                      <summary class="fifty-fifty-highlights__summary">
                        <span class="fifty-fifty-highlights__summary-label">{item.accordionTitle}</span>
                        <span class="fifty-fifty-highlights__summary-icon" aria-hidden="true">
                          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                            <path d="M-0.000211854 8.09495C-0.000219783 7.83512 0.0844956 7.62049 0.25401 7.45098C0.424289 7.2807 0.639375 7.19553 0.899218 7.19552L7.19528 7.19551L7.19529 0.899454C7.19528 0.639619 7.28043 0.424952 7.45073 0.255456C7.62022 0.0851675 7.83488 1.54147e-05 8.09473 1.48509e-05C8.35456 2.27904e-05 8.56963 0.085163 8.73992 0.255457C8.90941 0.424946 8.99415 0.639615 8.99416 0.89945L8.99415 7.19551L15.2902 7.19549C15.55 7.1955 15.7647 7.28065 15.9342 7.4509C16.1045 7.62044 16.1897 7.83513 16.1897 8.09495C16.1897 8.35479 16.1045 8.56985 15.9342 8.74014C15.7647 8.90963 15.5501 8.99439 15.2902 8.99439L8.99415 8.99438L8.99416 15.2905C8.99415 15.5503 8.9094 15.7653 8.73988 15.9357C8.56961 16.1051 8.35455 16.1899 8.09473 16.1899C7.8349 16.1899 7.62019 16.1051 7.45067 15.9356C7.2804 15.7653 7.19528 15.5503 7.19527 15.2904L7.19527 8.99438L0.899223 8.99439C0.639388 8.99438 0.424276 8.90969 0.254041 8.74014C0.0844846 8.5699 -0.00020391 8.35479 -0.000211854 8.09495Z" fill="#3B2115" />
                          </svg>
                        </span>
                      </summary>
                      <div class="fifty-fifty-highlights__accordion-body rich-text">
                        <PortableText value={item.accordionBody || []} />
                      </div>
                    </details>
                  ) : (
                    <div class="fifty-fifty-highlights__cta-wrap">
                      <a class="button button--primary-accent" href={item.ctaHref}>
                        <span>{item.ctaLabel}</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
                        </svg>
                      </a>
                    </div>
                  )
                }
              </div>
              <div class="fifty-fifty-highlights__media">
                <SanityImage
                  image={item.image}
                  alt={item.image?.alt || ''}
                  width={460}
                  height={320}
                  fit="crop"
                  widths={[320, 420, 460, 640, 920, 1280]}
                  class="fifty-fifty-highlights__image"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  sizes="(min-width: 64rem) 29rem, (min-width: 48rem) 40vw, 100vw"
                />
              </div>
            </article>
          );
        })}
        </div>
      </div>
    </section>
  )
}
