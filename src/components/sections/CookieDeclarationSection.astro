---
const {cookiebotId, culture = 'FI', internalTitle} = Astro.props as {
  cookiebotId?: string
  culture?: string
  internalTitle?: string
}

const normalizedCookiebotId = typeof cookiebotId === 'string' ? cookiebotId.trim() : ''
const normalizedCulture = typeof culture === 'string' ? culture.trim().toUpperCase() : 'FI'
const hasContent = normalizedCookiebotId.length > 0
const ariaLabel = internalTitle || 'Cookie declaration section'
---

{
  hasContent && (
    <section class="page-section cookie-declaration-section" aria-label={ariaLabel}>
      <div class="site-container cookie-declaration-section__container">
        <div class="cookie-declaration-section__content">
          <script
            id="CookieDeclaration"
            src={`https://consent.cookiebot.com/${normalizedCookiebotId}/cd.js`}
            type="text/javascript"
            async
            data-culture={normalizedCulture}
          ></script>
        </div>
      </div>
    </section>
  )
}
