---
import SanityImage from '../SanityImage.astro'

interface ReferenceItem {
  _id?: string
  title?: string
  slug?: {current?: string}
  image?: {alt?: string}
  areas?: string[]
  shortDescription?: string
  quote?: string
  quoteAuthor?: string
}

const {
  eyebrow,
  title,
  description,
  textAlignment,
  ctaLabel,
  ctaHref,
  references = [],
} = Astro.props as {
  eyebrow?: string
  title?: string
  description?: string
  textAlignment?: 'center' | 'left'
  ctaLabel?: string
  ctaHref?: string
  references?: ReferenceItem[]
}

const cards = references.filter((item) => item?.title && item?.slug?.current)
const hasCta = Boolean(ctaLabel && ctaHref)
const eyebrowText = typeof eyebrow === 'string' ? eyebrow.trim() : ''
const descriptionText = typeof description === 'string' ? description.trim() : ''
const titleText = typeof title === 'string' ? title.trim() : ''
const introAlignmentClass = textAlignment === 'left' ? 'reference-section__intro--left' : ''

// Each card is rendered exactly once. We keep its original index so CSS can
// linearise the columns back into a single ordered stream on mobile.
const cardsWithIndex = cards.map((item, index) => ({item, index}))
// Desktop splits into two independent columns: the intro + CTA live in the
// left column together with the odd-indexed cards, even-indexed cards go right.
const leftColumnCards = cardsWithIndex.filter(({index}) => index % 2 === 1)
const rightColumnCards = cardsWithIndex.filter(({index}) => index % 2 === 0)

const areaLabels: Record<string, string> = {
  verkkosivusto: 'Verkkosivut',
  verkkokauppa: 'Verkkokauppa',
  'brandi-ilme': 'Brändi-ilme',
  sisalto: 'Sisältö',
  yllapito: 'Ylläpito',
}

const getCardLabel = (item: ReferenceItem) => {
  const areaKey = Array.isArray(item.areas) ? item.areas[0] : ''
  return typeof areaKey === 'string' ? areaLabels[areaKey] || areaKey : ''
}

// A 5:4 source covers both layouts: mobile shows it as-is, desktop (16:10)
// trims the top/bottom via object-fit: cover.
const cardImageSizes = '(min-width: 80rem) 38rem, (min-width: 48rem) 36vw, 100vw'
---

{
  cards.length > 0 && (
    <section class="page-section reference-section" aria-label={eyebrowText || titleText || 'Portfolio'}>
      <div class="site-container reference-section__container">
        <div class="reference-section__grid">
          <div class="reference-section__column reference-section__column--left">
            <div class:list={['reference-section__intro', introAlignmentClass]}>
              {eyebrowText && (
                <div class="reference-section__eyebrow-wrap">
                  <span class="reference-section__eyebrow-dot" aria-hidden="true"></span>
                  <p class="reference-section__eyebrow">{eyebrowText}</p>
                </div>
              )}
              {titleText && <h2 class="reference-section__title">{titleText}</h2>}
              {descriptionText && <p class="reference-section__description">{descriptionText}</p>}
            </div>

            {hasCta && (
              <div class="reference-section__cta-wrap">
                <a class="reference-section__cta button--link-secondary" href={ctaHref}>
                  <span>{ctaLabel}</span>
                  <svg class="button__arrow" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12H17" />
                    <path d="M12 7L17 12L12 17" />
                  </svg>
                </a>
              </div>
            )}

            {leftColumnCards.map(({item, index}) => (
              <a
                class="reference-card"
                style={`--card-order:${index + 1}`}
                href={`/referenssit/${item.slug?.current}`}
              >
                <div class="reference-card__image-wrap">
                  {item.image ? (
                    <SanityImage
                      image={item.image}
                      alt={item.image.alt || item.title || ''}
                      width={1200}
                      height={960}
                      fit="crop"
                      quality={100}
                      dpr={2}
                      widths={[320, 480, 640, 800, 960, 1200, 1440, 1920, 2400]}
                      class="reference-card__image"
                      sizes={cardImageSizes}
                    />
                  ) : (
                    <div class="reference-card__image reference-card__image--placeholder"></div>
                  )}
                </div>
                <h3 class="reference-card__title">{item.title}</h3>
                {(getCardLabel(item) || item.shortDescription) && (
                  <div class="reference-card__meta">
                    {getCardLabel(item) && <span class="reference-card__badge">{getCardLabel(item)}</span>}
                    {item.shortDescription && <p class="reference-card__description">{item.shortDescription}</p>}
                  </div>
                )}
                {item.quote && (
                  <p class="reference-card__quote">
                    ”{item.quote.trim()}”{item.quoteAuthor && ` — ${item.quoteAuthor.trim()}`}
                  </p>
                )}
              </a>
            ))}
          </div>

          {rightColumnCards.length > 0 && (
            <div class="reference-section__column reference-section__column--right">
              {rightColumnCards.map(({item, index}) => (
                <a
                  class="reference-card"
                  style={`--card-order:${index + 1}`}
                  href={`/referenssit/${item.slug?.current}`}
                >
                  <div class="reference-card__image-wrap">
                    {item.image ? (
                      <SanityImage
                        image={item.image}
                        alt={item.image.alt || item.title || ''}
                        width={1200}
                        height={960}
                        fit="crop"
                        quality={100}
                        dpr={2}
                        widths={[320, 480, 640, 800, 960, 1200, 1440, 1920, 2400]}
                        class="reference-card__image"
                        sizes={cardImageSizes}
                      />
                    ) : (
                      <div class="reference-card__image reference-card__image--placeholder"></div>
                    )}
                  </div>
                  <h3 class="reference-card__title">{item.title}</h3>
                  {(getCardLabel(item) || item.shortDescription) && (
                    <div class="reference-card__meta">
                      {getCardLabel(item) && <span class="reference-card__badge">{getCardLabel(item)}</span>}
                      {item.shortDescription && <p class="reference-card__description">{item.shortDescription}</p>}
                    </div>
                  )}
                  {item.quote && (
                    <p class="reference-card__quote">
                      ”{item.quote.trim()}”{item.quoteAuthor && ` — ${item.quoteAuthor.trim()}`}
                    </p>
                  )}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
