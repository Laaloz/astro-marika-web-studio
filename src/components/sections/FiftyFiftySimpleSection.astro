---
import {PortableText} from 'astro-portabletext';
import type {PortableTextBlock} from '@portabletext/types';
import SanityImage from '../SanityImage.astro';
import PortableTextPriceNote from '../portable-text/PortableTextPriceNote.astro';

const portableTextComponents = {
  block: {
    priceNote: PortableTextPriceNote,
  },
};

// priority: osio on sivun yläosassa (heti heron jälkeen), jolloin kuva on
// yleensä sivun LCP-elementti ja se ladataan heti korkealla prioriteetilla.
const {title, body, image, imageSide = 'left', imageAspect = 'square', priority = false} = Astro.props as {
  title?: string;
  priority?: boolean;
  body?: PortableTextBlock[];
  image?: {alt?: string};
  imageSide?: 'left' | 'right';
  imageAspect?: 'square' | 'landscape';
};

const hasContent = Boolean(title && Array.isArray(body) && body.length > 0 && image);
const imageOnLeft = imageSide === 'left';
const isLandscape = imageAspect === 'landscape';
const imageClass = `fifty-fifty-simple__image${isLandscape ? ' fifty-fifty-simple__image--landscape' : ''}`;
---

{
  hasContent && (
    <section class="page-section fifty-fifty-simple" aria-label={title || '50/50 content'}>
      <div class="site-container fifty-fifty-simple__container">
        <article class:list={{'fifty-fifty-simple__row': true, 'fifty-fifty-simple__row--image-left': imageOnLeft}}>
          <div class="fifty-fifty-simple__content">
            <h2 class="fifty-fifty-simple__title">{title}</h2>
            <div class="fifty-fifty-simple__body rich-text">
              <PortableText value={body} components={portableTextComponents} />
            </div>
          </div>

          <div class="fifty-fifty-simple__media">
            <SanityImage
              image={image}
              alt={image?.alt || ''}
              width={isLandscape ? 1040 : 530}
              height={isLandscape ? 832 : 530}
              fit="crop"
              widths={[360, 460, 530, 720, 800, 1060, 1280, 1600]}
              class={imageClass}
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority ? 'high' : undefined}
              decoding="async"
              sizes="(min-width: 80rem) 33.125rem, (min-width: 48rem) 40vw, calc(100vw - 2rem)"
            />
          </div>
        </article>
      </div>
    </section>
  )
}
