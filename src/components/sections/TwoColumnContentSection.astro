---
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'
import PortableTextImage from '../portable-text/PortableTextImage.astro'
import PortableTextPullQuote from '../portable-text/PortableTextPullQuote.astro'

const {
  leftEyebrow,
  title,
  rightEyebrow,
  rightTitle,
  leftBody,
  body,
  leftCtaLabel,
  leftCtaHref,
  rightCtaLabel,
  rightCtaHref,
  ctaStyle = 'button',
  backgroundStyle = 'none',
} = Astro.props as {
  leftEyebrow?: string
  title?: string
  rightEyebrow?: string
  rightTitle?: string
  leftBody?: PortableTextBlock[]
  body?: PortableTextBlock[]
  leftCtaLabel?: string
  leftCtaHref?: string
  rightCtaLabel?: string
  rightCtaHref?: string
  ctaStyle?: 'button' | 'link'
  backgroundStyle?: 'none' | 'brown'
}

const hasTitle = Boolean(typeof title === 'string' && title.trim())
const hasLeftEyebrow = Boolean(typeof leftEyebrow === 'string' && leftEyebrow.trim())
const hasRightTitle = Boolean(typeof rightTitle === 'string' && rightTitle.trim())
const hasRightEyebrow = Boolean(typeof rightEyebrow === 'string' && rightEyebrow.trim())
const hasLeftBody = Array.isArray(leftBody) && leftBody.length > 0
const hasBody = Array.isArray(body) && body.length > 0
const hasLeftCta = Boolean(leftCtaLabel && leftCtaHref)
const hasRightCta = Boolean(rightCtaLabel && rightCtaHref)
const hasLeftContent = Boolean(hasLeftEyebrow || hasTitle || hasLeftBody || hasLeftCta)
const hasRightContent = Boolean(hasRightEyebrow || hasRightTitle || hasBody || hasRightCta)
const hasContent = Boolean(hasLeftContent || hasRightContent)
const hasBackground = backgroundStyle === 'brown'
const isLinkCta = ctaStyle === 'link'

const portableTextComponents = {
  type: {
    image: PortableTextImage,
  },
  block: {
    pullQuote: PortableTextPullQuote,
  },
}
---

{
  hasContent && (
    <section
      class:list={{
        'page-section two-column-content': true,
        'two-column-content--brown has-background': hasBackground,
        'two-column-content--right-only': hasRightContent && !hasLeftContent,
      }}
      aria-label={title || rightTitle || 'Kaksipalstainen sisältö'}
    >
      <div class="site-container two-column-content__container">
        <div class="two-column-content__grid">
          {hasLeftContent && (
            <div class="two-column-content__left">
              {(hasLeftEyebrow || hasTitle) && (
                <div class="two-column-content__heading">
                  {hasLeftEyebrow && (
                    <div class="two-column-content__eyebrow-wrap">
                      <span class="two-column-content__eyebrow-dot" aria-hidden="true"></span>
                      <p class="two-column-content__eyebrow">{leftEyebrow}</p>
                    </div>
                  )}
                  {hasTitle && <h2 class="two-column-content__title">{title}</h2>}
                </div>
              )}

              {hasLeftBody && (
                <div class="two-column-content__left-body rich-text">
                  <PortableText value={leftBody} components={portableTextComponents} />
                </div>
              )}

              {hasLeftCta && (isLinkCta ? (
                <a class="two-column-content__link" href={leftCtaHref}>
                  <span>{leftCtaLabel}</span>
                  <svg viewBox="0 0 21 21" aria-hidden="true">
                    <path d="M17.6148 10.9375H0V9.47917H17.6148L9.16781 1.03214L10.2083 0L20.4167 10.2083L10.2083 20.4167L9.16781 19.3845L17.6148 10.9375Z" fill="currentColor" />
                  </svg>
                </a>
              ) : (
                <a class="button button--primary-outline two-column-content__button" href={leftCtaHref}>
                  <span>{leftCtaLabel}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
                  </svg>
                </a>
              ))}
            </div>
          )}

          {hasRightContent && (
            <div class="two-column-content__body">
              {(hasRightEyebrow || hasRightTitle) && (
                <div class="two-column-content__heading">
                  {hasRightEyebrow && (
                    <div class="two-column-content__eyebrow-wrap">
                      <span class="two-column-content__eyebrow-dot" aria-hidden="true"></span>
                      <p class="two-column-content__eyebrow">{rightEyebrow}</p>
                    </div>
                  )}
                  {hasRightTitle && (
                    <h2 class="two-column-content__title two-column-content__title--right">{rightTitle}</h2>
                  )}
                </div>
              )}

              {hasBody && (
                <div class="two-column-content__body-text rich-text">
                  <PortableText value={body} components={portableTextComponents} />
                </div>
              )}

              {hasRightCta && (isLinkCta ? (
                <a class="two-column-content__link" href={rightCtaHref}>
                  <span>{rightCtaLabel}</span>
                  <svg viewBox="0 0 21 21" aria-hidden="true">
                    <path d="M17.6148 10.9375H0V9.47917H17.6148L9.16781 1.03214L10.2083 0L20.4167 10.2083L10.2083 20.4167L9.16781 19.3845L17.6148 10.9375Z" fill="currentColor" />
                  </svg>
                </a>
              ) : (
                <a class="button button--primary-outline two-column-content__button" href={rightCtaHref}>
                  <span>{rightCtaLabel}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
                  </svg>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
