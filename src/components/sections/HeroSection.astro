---
import SanityImage from '../SanityImage.astro';

const {
  eyebrow,
  headingPrefix,
  description,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  image,
} = Astro.props;

const hasPrimaryCta = primaryCtaLabel && primaryCtaHref;
const hasSecondaryCta = secondaryCtaLabel && secondaryCtaHref;
---

<section class="page-section hero-block">
	<div class="hero-block__media" aria-hidden="true">
		{
			image ? (
				<SanityImage
					image={image}
					alt=""
					width={1600}
					height={900}
					fit="crop"
					quality={90}
					widths={[640, 960, 1280, 1600, 2000]}
					class="hero-block__image"
					loading="eager"
					fetchpriority="high"
					decoding="async"
					sizes="100vw"
				/>
			) : (
				<div class="hero-block__image hero-block__image--placeholder"></div>
			)
		}
	</div>
	<div class="site-container hero-block__container">
		<div class="hero-block__wrapper">
			<div class="hero-block__copy">
				<div class="hero-block__headline-group">
					<p class="hero-block__eyebrow">{eyebrow}</p>
					<h1 class="hero-block__title">{headingPrefix}</h1>
				</div>
				<div class="hero-block__body">
					<p>{description}</p>
				</div>
			</div>

			<div class="actions-row hero-block__actions">
				{hasPrimaryCta && (
					<a class="button button--primary-brand--accent hero-block__button hero-block__button--secondary" href={primaryCtaHref}>
						<span>{primaryCtaLabel}</span>
					</a>
				)}
				{hasSecondaryCta && (
					<a class="button button--primary-brand hero-block__button hero-block__button--primary" href={secondaryCtaHref}>
						<span>{secondaryCtaLabel}</span>
						<svg class="button__arrow" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<mask id="hero-secondary-arrow-mask" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
								<rect width="24" height="24" fill="#D9D9D9" />
							</mask>
							<g mask="url(#hero-secondary-arrow-mask)">
								<path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" fill="#322221" />
							</g>
						</svg>
					</a>
				)}
			</div>
		</div>
	</div>
</section>
