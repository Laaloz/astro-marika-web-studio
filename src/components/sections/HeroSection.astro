---
import SanityImage from '../SanityImage.astro';

const {
  eyebrow,
  headingPrefix,
  headingEmphasis,
  headingSuffix,
  description,
  note,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  image,
} = Astro.props;

const hasSecondaryCta = secondaryCtaLabel && secondaryCtaHref;
---

<section class="page-section hero-block">
	<svg
		class="hero-block__ornament"
		viewBox="0 0 903 620"
		fill="none"
		aria-hidden="true"
	>
		<path d="M0.147954 -7.7184C-0.089349 12.9288 -0.289183 33.6025 1.63422 54.2143C3.55763 74.8261 7.5668 95.1191 15.71 114.828C22.2671 130.676 31.7717 145.976 44.3363 159.894C56.9009 173.812 72.0508 185.951 90.4106 195.717C99.5405 200.577 109.395 204.748 119.811 208.059C131.989 211.919 144.828 214.469 157.68 216.93C170.532 219.392 184.158 221.924 196.622 225.926C206.252 229.016 215.257 233.027 223.263 237.923C238.5 247.246 249.928 259.367 257.634 272.488C265.341 285.61 269.999 301.069 271.223 315.925C271.848 323.46 271.673 331.021 270.749 338.538C269.724 346.87 267.576 355.059 264.928 363.196C258.496 383.011 249.529 402.702 248.904 423.208C248.392 439.755 253.863 456.073 263.692 471.036C273.584 486.105 287.659 499.687 303.734 511.737C319.808 523.787 338.742 534.828 358.501 544.302C380.47 554.829 403.851 563.94 427.868 571.899C451.886 579.859 477.827 586.96 503.693 592.759C529.684 598.585 556.174 603.295 582.915 607.049C609.655 610.803 636.483 613.574 663.51 615.575C693.635 617.806 723.898 619.064 754.185 619.63C784.472 620.197 815.21 620.073 845.722 619.524C876.159 618.975 906.584 618.019 936.996 616.921C951.734 616.39 966.459 615.823 981.197 615.265C983.595 615.177 983.607 612.521 981.197 612.609C950.897 613.769 920.597 614.929 890.285 615.805C859.872 616.691 829.448 617.293 799.01 617.346C768.723 617.39 738.436 616.886 708.198 615.549C679.572 614.283 650.996 612.273 622.632 609.254C595.829 606.403 569.201 602.675 542.923 597.93C516.745 593.193 490.916 587.438 465.724 580.496C440.595 573.573 416.103 565.454 392.622 556.06C371.003 547.41 350.183 537.741 331.173 526.39C313.051 515.562 296.402 503.317 282.951 489.443C269.5 475.569 260.082 461.208 255.474 445.28C253.038 436.869 252.189 428.263 252.851 419.693C253.638 409.466 256.435 399.382 259.733 389.43C265.603 371.758 272.934 354.307 274.77 336.112C276.281 321.185 274.833 306.036 270.074 291.445C265.316 276.853 257.659 263.626 245.869 251.779C234.016 239.871 218.23 230.105 199.52 223.96C175.028 215.921 147.688 213.805 122.984 206.173C102.051 199.701 83.6037 189.758 68.2789 177.814C52.7668 165.72 40.427 151.651 31.0223 136.75C20.3187 119.777 13.7617 101.609 9.76498 83.2727C5.34365 63.0151 4.09468 42.4741 3.80742 22.004C3.67003 12.0965 3.76995 2.18906 3.88236 -7.7184C3.90734 -9.4272 0.160444 -9.4272 0.147954 -7.7184Z" fill="#74670A"/>
	</svg>
	<div class="section-container hero-block__container">
		<div class="hero-block__copy">
			<p class="hero-block__eyebrow">{eyebrow}</p>
			<h1 class="hero-block__title">
				<span class="hero-block__title-part hero-block__title-part--base">{headingPrefix}</span>
				<span class="hero-block__title-part hero-block__title-part--accent">{headingEmphasis}</span>
				{headingSuffix && <span class="hero-block__title-part hero-block__title-part--base">{headingSuffix}</span>}
			</h1>
			<div class="hero-block__body">
				<p>{description}</p>
				{note && <p class="hero-block__note">{note}</p>}
			</div>
			<div class="actions-row hero-block__actions">
				<a class="button button--hero-primary" href={primaryCtaHref}>
					<span>{primaryCtaLabel}</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M5 12H17" />
						<path d="M12 7L17 12L12 17" />
					</svg>
				</a>
				{hasSecondaryCta && (
					<a class="button button--hero-secondary" href={secondaryCtaHref}>
						<span>{secondaryCtaLabel}</span>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M5 12H17" />
							<path d="M12 7L17 12L12 17" />
						</svg>
					</a>
				)}
			</div>
		</div>
		<div class="hero-block__media">
			<div class="hero-block__media-frame">
			{
				image ? (
					<SanityImage
						image={image}
						alt={image.alt || ''}
						width={527}
						height={791}
						fit="crop"
						widths={[320, 420, 527, 640]}
						class="hero-block__image"
						loading="eager"
						fetchpriority="high"
						decoding="async"
						sizes="(min-width: 64rem) 38rem, 100vw"
					/>
				) : (
					<div class="hero-block__image hero-block__image--placeholder"></div>
				)
			}
			</div>
		</div>
	</div>
</section>
