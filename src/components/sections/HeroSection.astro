---
import SanityImage from '../SanityImage.astro';

const {
  eyebrow,
  headingPrefix,
  headingEmphasis,
  headingSuffix,
  description,
  note,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  image,
} = Astro.props;

const hasSecondaryCta = secondaryCtaLabel && secondaryCtaHref;
---

<section class="hero-block">
	<div class="hero-block__copy">
		<p class="hero-block__eyebrow">{eyebrow}</p>
		<h1 class="hero-block__title">
			<span class="hero-block__title-part hero-block__title-part--base">{headingPrefix}</span>
			<span class="hero-block__title-part hero-block__title-part--accent">{headingEmphasis}</span>
			{headingSuffix && <span class="hero-block__title-part hero-block__title-part--base">{headingSuffix}</span>}
		</h1>
		<div class="hero-block__body">
			<p>{description}</p>
			{note && <p class="hero-block__note">{note}</p>}
		</div>
		<div class="actions-row hero-block__actions">
			<a class="button button--hero-primary" href={primaryCtaHref}>
				{primaryCtaLabel}
			</a>
			{hasSecondaryCta && (
				<a class="button button--hero-secondary" href={secondaryCtaHref}>
					{secondaryCtaLabel}
				</a>
			)}
		</div>
	</div>
	<div class="hero-block__media">
		{
			image ? (
				<SanityImage
					image={image}
					alt={image.alt || ''}
					width={760}
					height={900}
					fit="crop"
					class="hero-block__image"
					sizes="(min-width: 64rem) 38rem, 100vw"
				/>
			) : (
				<div class="hero-block__image hero-block__image--placeholder"></div>
			)
		}
	</div>
</section>
