---
import SanityImage from '../SanityImage.astro'

interface ScrollingItem {
  _key?: string
  text?: string
  icon?: Record<string, unknown> | null
}

const {items = []} = Astro.props as {
  items?: ScrollingItem[]
}

const normalizedItems = items
  .map((item) => ({
    text: item?.text?.trim() || '',
    icon: item?.icon || null,
  }))
  .filter((item) => Boolean(item.text))
---

{
  normalizedItems.length > 0 && (
    <section class="scrolling-text" aria-hidden="true" data-scrolling-text>
      <div class="scrolling-text__track" data-scrolling-track>
        <div class="scrolling-text__set" role="list" data-scrolling-set>
          {normalizedItems.map((item) => (
            <div class="scrolling-text__item" role="listitem">
              {item.icon && (
                <SanityImage
                  image={item.icon}
                  alt=""
                  width={24}
                  height={24}
                  class="scrolling-text__icon"
                  fit="crop"
                  widths={[24, 48]}
                  loading="lazy"
                />
              )}
              <span class="scrolling-text__label">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  const sections = document.querySelectorAll('[data-scrolling-text]')

  for (const section of sections) {
    const track = section.querySelector('[data-scrolling-track]')
    const originalSet = section.querySelector('[data-scrolling-set]')

    if (!(track instanceof HTMLElement) || !(originalSet instanceof HTMLElement)) continue

    const build = () => {
      const clones = track.querySelectorAll('[data-scrolling-clone="true"]')
      for (const clone of clones) clone.remove()

      const setWidth = originalSet.getBoundingClientRect().width
      if (!setWidth) return

      const probeClone = originalSet.cloneNode(true)
      if (!(probeClone instanceof HTMLElement)) return
      probeClone.setAttribute('data-scrolling-clone', 'true')
      probeClone.setAttribute('aria-hidden', 'true')
      track.appendChild(probeClone)

      const firstSetRect = originalSet.getBoundingClientRect()
      const probeRect = probeClone.getBoundingClientRect()
      const unitWidth = probeRect.left - firstSetRect.left
      if (!unitWidth) {
        probeClone.remove()
        return
      }

      const viewportWidth = section.getBoundingClientRect().width
      const minimumTrackWidth = Math.max(viewportWidth * 2, unitWidth * 2)
      const neededSets = Math.max(2, Math.ceil(minimumTrackWidth / unitWidth))

      for (let i = 2; i < neededSets; i += 1) {
        const clone = originalSet.cloneNode(true)
        if (clone instanceof HTMLElement) {
          clone.setAttribute('data-scrolling-clone', 'true')
          clone.setAttribute('aria-hidden', 'true')
          track.appendChild(clone)
        }
      }

      section.style.setProperty('--scrolling-loop-distance', `${unitWidth}px`)
      const speed = 90
      const duration = Math.max(12, unitWidth / speed)
      section.style.setProperty('--scrolling-duration', `${duration}s`)

      track.style.animation = 'none'
      track.getBoundingClientRect()
      track.style.animation = ''
    }

    build()

    let resizeRaf = 0
    const resizeObserver = new ResizeObserver(() => {
      if (resizeRaf) cancelAnimationFrame(resizeRaf)
      resizeRaf = requestAnimationFrame(() => {
        build()
      })
    })

    resizeObserver.observe(section)
  }
</script>
