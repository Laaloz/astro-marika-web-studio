---
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'

const {eyebrow, title, body, ctaLabel, ctaHref} = Astro.props as {
  eyebrow?: string
  title?: string
  body?: PortableTextBlock[]
  ctaLabel?: string
  ctaHref?: string
}

const hasRequiredContent = Boolean(title && Array.isArray(body) && body.length > 0 && ctaLabel && ctaHref)
const eyebrowText = typeof eyebrow === 'string' ? eyebrow.trim() : ''

const ctaBottomVector = `
<svg xmlns="http://www.w3.org/2000/svg" width="1440" height="162" viewBox="0 0 1440 162" fill="none" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <path d="M348.184 66.7714C372.665 59.2159 390.397 59.0645 396.611 69.75C402.824 80.4355 393.826 95.6068 374.995 112.88C400.001 118.49 415.433 127.162 415.433 139.5C415.433 148.983 406.316 156.301 390.743 161.727H159.122C143.549 156.301 134.433 148.983 134.433 139.5C134.433 127.161 149.865 118.489 174.872 112.879C156.042 95.6066 147.044 80.4354 153.257 69.75C159.471 59.0645 177.203 59.2159 201.684 66.7714C194.074 42.4643 193.922 24.8587 204.684 18.6895C215.446 12.5203 230.725 21.4537 248.122 40.1497C253.772 15.3221 262.506 0 274.933 0C287.36 0 296.094 15.3231 301.744 40.1521C319.141 21.4545 334.422 12.5201 345.184 18.6895C355.946 24.8587 355.794 42.4643 348.184 66.7714Z" fill="#477EFF" style="mix-blend-mode:multiply"/>
  <path d="M-173.567 161.727H135.886C135.886 76.2734 66.6123 7 -18.8408 7C-104.294 7 -173.567 76.2734 -173.567 161.727Z" fill="#FFE4CF"/>
  <path d="M412.751 161.727H721.568C716.414 80.9338 649.253 17 567.159 17C485.065 17 417.904 80.9338 412.751 161.727Z" fill="#FFE4CF"/>
  <path d="M1304.75 161.727H1613.57C1608.41 80.9338 1541.25 17 1459.16 17C1377.07 17 1309.9 80.9338 1304.75 161.727Z" fill="#FFA952"/>
  <path d="M1304.43 161.727H1030.43V33.8701H1304.43V161.727Z" fill="#FFE4CF"/>
  <path d="M721.751 161.727H1030.57C1025.41 80.9338 958.253 17 876.159 17C794.065 17 726.904 80.9338 721.751 161.727Z" fill="#FFDE70"/>
</svg>`

const ctaBottomVectorMobile = `
<svg xmlns="http://www.w3.org/2000/svg" width="393" height="71" viewBox="0 0 393 71" fill="none" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <path d="M42.4283 29.3135C53.1369 25.9965 60.8931 25.9301 63.611 30.6211C66.3289 35.3122 62.393 41.9726 54.1559 49.5556C65.0938 52.0186 71.8441 55.8256 71.8441 61.2423C71.8441 65.4056 67.8563 68.6179 61.0443 71H-40.2705C-47.0825 68.6179 -51.0703 65.4056 -51.0703 61.2423C-51.0703 55.8254 -44.3197 52.0184 -33.3812 49.5554C-41.6181 41.9725 -45.5539 35.3122 -42.836 30.6211C-40.1181 25.9301 -32.3619 25.9965 -21.6533 29.3135C-24.982 18.6424 -25.0486 10.9133 -20.3411 8.20491C-15.6337 5.49658 -8.95014 9.41845 -1.34075 17.6262C1.13087 6.72659 4.95117 0 10.3869 0C15.8228 0 19.6431 6.72702 22.1147 17.6273C29.7245 9.41878 36.4084 5.49646 41.1161 8.20491C45.8236 10.9133 45.7569 18.6424 42.4283 29.3135Z" fill="#477EFF" style="mix-blend-mode:multiply"/>
  <path d="M70.6709 71H198.319C196.189 35.531 168.428 7.46321 134.495 7.46321C100.562 7.46321 72.8012 35.531 70.6709 71Z" fill="#FFE4CF"/>
  <path d="M444.07 71H324.218V8.20483H444.07V71Z" fill="#FFA952"/>
  <path d="M198.319 71H324.306C322.203 35.531 294.804 7.46321 261.313 7.46321C227.821 7.46321 200.422 35.531 198.319 71Z" fill="#FFDE70"/>
</svg>`
---

{
  hasRequiredContent && (
    <section class="page-section call-to-action" aria-label={title || 'Ota yhteyttä'}>
      <div class="site-container call-to-action__container">
        <div class="call-to-action__content">
          <div class="call-to-action__title-column">
            {eyebrowText && (
              <div class="call-to-action__eyebrow-wrap">
                <span class="call-to-action__eyebrow-dot" aria-hidden="true"></span>
                <p class="call-to-action__eyebrow">{eyebrowText}</p>
              </div>
            )}
            <h2 class="call-to-action__title">{title}</h2>
          </div>

          <div class="call-to-action__body-column">
            <div class="call-to-action__body rich-text">
              <PortableText value={body} />
            </div>

            <a class="button button--primary-brand home-hero__button home-hero__button--primary call-to-action__button" href={ctaHref}>
              <span>{ctaLabel}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="call-to-action__vector call-to-action__vector--desktop" set:html={ctaBottomVector}></div>
      <div class="call-to-action__vector call-to-action__vector--mobile" set:html={ctaBottomVectorMobile}></div>
    </section>
  )
}
