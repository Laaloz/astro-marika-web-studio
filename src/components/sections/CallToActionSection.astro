---
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'
import SanityImage from '../SanityImage.astro'

import defaultIcon from '../../assets/design-implementation-sparkle.svg?raw'
const mobileCurveSvg = 'http://localhost:3845/assets/d2abc672e6f36cda72e4f49f3090c9a94d723414.svg'

const {
  eyebrow,
  title,
  body,
  ctaLabel,
  ctaHref,
  badgeTopLine,
  badgeBottomLine,
  introIcon,
} = Astro.props as {
  eyebrow?: string
  title?: string
  body?: PortableTextBlock[]
  ctaLabel?: string
  ctaHref?: string
  badgeTopLine?: string
  badgeBottomLine?: string
  introIcon?: unknown
}

const hasRequiredContent = Boolean(
  eyebrow &&
    title &&
    Array.isArray(body) &&
    body.length > 0 &&
    ctaLabel &&
    ctaHref,
)
---

{
  hasRequiredContent && (
    <section class="page-section call-to-action" aria-label={eyebrow || title || 'Ota yhteyttä'}>
      <div class="site-container call-to-action__container">
        <div class="call-to-action__card">
          <svg
            class="call-to-action__curve-svg call-to-action__curve-svg--desktop"
            xmlns="http://www.w3.org/2000/svg"
            width="1440"
            height="526"
            viewBox="0 0 1440 526"
            fill="none"
            aria-hidden="true"
          >
            <path d="M1486.75 1.07173C1487.15 18.3378 1487.48 35.6263 1484.28 52.8628C1481.07 70.0993 1474.39 87.0695 1460.82 103.551C1449.9 116.804 1434.06 129.598 1413.12 141.237C1392.18 152.876 1366.94 163.027 1336.35 171.194C1321.13 175.259 1304.71 178.746 1287.36 181.515C1267.06 184.743 1245.67 186.876 1224.25 188.934C1202.84 190.992 1180.13 193.11 1159.36 196.456C1143.32 199.04 1128.31 202.394 1114.97 206.489C1089.58 214.285 1070.54 224.421 1057.7 235.394C1044.86 246.367 1037.09 259.294 1035.05 271.718C1034.01 278.019 1034.3 284.342 1035.84 290.628C1037.55 297.595 1041.13 304.444 1045.54 311.248C1056.26 327.818 1071.2 344.285 1072.24 361.433C1073.1 375.271 1063.98 388.916 1047.6 401.429C1031.12 414.031 1007.67 425.389 980.88 435.466C954.095 445.542 922.545 454.775 889.62 462.697C853.012 471.501 814.053 479.12 774.031 485.776C734.01 492.432 690.784 498.37 647.683 503.22C604.373 508.091 560.558 513.733 516 516.872C471.442 520.011 426.411 520.627 381.374 522.3C331.176 524.166 280.749 525.217 230.281 525.691C179.812 526.165 128.594 526.061 77.7505 525.602C27.0319 525.143 -23.6653 524.343 -74.3423 523.425C-98.9004 522.981 -123.437 522.507 -147.995 522.041C-151.991 521.967 -152.012 519.341 -147.995 519.415C-97.2461 519.011 -48.2461 520.938 3.75391 521.697C54.4309 522.438 105.035 522.223 155.754 522.268C206.473 522.312 255.5 522.007 306.5 521.436C354.59 518.883 402.5 518.584 449.492 517.013C494.154 514.629 540.5 512.308 583 506.603C626.622 502.642 670.276 497.266 712.254 491.461C754.127 485.671 784.754 479.48 824.254 472.064C863.754 464.647 895.754 455.519 935.754 445.821C965.952 436.766 993.097 428.424 1015.51 416.822C1037.93 405.22 1053.62 393.211 1061.3 379.891C1065.36 372.857 1066.77 365.66 1065.67 358.493C1064.36 349.942 1059.69 341.508 1054.2 333.186C1044.42 318.408 1032.2 303.815 1029.14 288.599C1026.62 276.116 1029.04 263.448 1036.97 251.246C1044.9 239.044 1057.66 227.983 1077.3 218.076C1097.05 208.118 1123.36 199.951 1154.53 194.813C1195.35 188.09 1240.9 186.32 1282.07 179.938C1316.95 174.526 1347.69 166.211 1373.22 156.223C1399.07 146.109 1419.64 134.344 1435.31 121.883C1453.14 107.69 1464.07 92.4965 1470.73 77.1628C1478.1 60.2225 1480.18 43.0451 1480.66 25.927C1480.88 17.6419 1480.72 9.35679 1480.53 1.07173C1480.49 -0.357242 1486.73 -0.357242 1486.75 1.07173Z" fill="#74670A"></path>
          </svg>
          <img
            class="call-to-action__curve-svg call-to-action__curve-svg--mobile"
            src={mobileCurveSvg}
            alt=""
            aria-hidden="true"
          />

          <div class="call-to-action__content">
            <div class="call-to-action__text-stack">
              <div class="call-to-action__header">
                <div class="call-to-action__eyebrow-wrap">
                  <div class="call-to-action__icon" aria-hidden="true">
                    {
                      introIcon ? (
                        <SanityImage
                          image={introIcon}
                          alt=""
                          width={24}
                          height={24}
                          class="call-to-action__icon-image"
                          loading="lazy"
                          decoding="async"
                          sizes="24px"
                        />
                      ) : (
                        <div class="call-to-action__icon-fallback" set:html={defaultIcon}></div>
                      )
                    }
                  </div>
                  <p class="call-to-action__eyebrow">{eyebrow}</p>
                </div>
                <h2 class="call-to-action__title">{title}</h2>
              </div>

              <div class="call-to-action__body rich-text">
                <PortableText value={body} />
              </div>
            </div>

            <a class="button button--primary-accent call-to-action__button" href={ctaHref}>
              <span>{ctaLabel}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
              </svg>
            </a>
          </div>
        </div>

        <aside class="call-to-action__badge" aria-hidden="true">
          <p class="call-to-action__badge-top">{badgeTopLine || 'Valmis'}</p>
          <p class="call-to-action__badge-bottom">{badgeBottomLine || 'tekemään vaikutuksen?'}</p>
        </aside>
      </div>
    </section>
  )
}
