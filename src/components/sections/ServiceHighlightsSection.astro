---
import {PortableText} from 'astro-portabletext'
import type {SanityImageSource} from '@sanity/image-url'
import SanityImage from '../SanityImage.astro'

interface ServiceItem {
  _key?: string
  title?: string
  body?: unknown[]
  buttonLabel?: string
  buttonHref?: string
  image?: SanityImageSource & {alt?: string}
}

const {
  eyebrow,
  title,
  body,
  secondaryLinkLabel,
  secondaryLinkHref,
  items = [],
} = Astro.props as {
  eyebrow?: string
  title?: string
  body?: unknown[]
  secondaryLinkLabel?: string
  secondaryLinkHref?: string
  items?: ServiceItem[]
}

const hasSecondaryLink = Boolean(secondaryLinkLabel && secondaryLinkHref)
const cards = items.filter((item) => item?.title && item?.buttonLabel && item?.buttonHref)
---

{
  cards.length > 0 && (
    <section class="page-section service-highlights has-background" aria-label={eyebrow || title || 'Palvelut'}>
      <div class="site-container service-highlights__container">
        <div class="service-highlights__intro">
          <div class="service-highlights__text-stack">
            <div class="service-highlights__heading-group">
              {eyebrow && <p class="service-highlights__eyebrow">{eyebrow}</p>}
              {title && <h2 class="service-highlights__title">{title}</h2>}
            </div>
            {Array.isArray(body) && body.length > 0 && (
              <div class="service-highlights__body rich-text">
                <PortableText value={body} />
              </div>
            )}
          </div>
          {hasSecondaryLink && (
            <a class="button--link-secondary service-highlights__secondary-link" href={secondaryLinkHref}>
              <span>{secondaryLinkLabel}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12H17" />
                <path d="M12 7L17 12L12 17" />
              </svg>
            </a>
          )}
        </div>

        <div class="service-highlights__grid">
          {cards.map((item) => (
            <article class="service-card">
              <div class:list={['service-card__media', !item.image && 'service-card__media--placeholder']}>
                {item.image ? (
                  <SanityImage
                    image={item.image}
                    alt={item.image.alt || item.title || ''}
                    width={1200}
                    height={900}
                    fit="crop"
                    widths={[420, 640, 840, 1200, 1600, 1920]}
                    class="service-card__image"
                    loading="lazy"
                    decoding="async"
                    sizes="(min-width: 74rem) 24rem, (min-width: 48rem) 33vw, 100vw"
                  />
                ) : (
                  <div class="service-card__media-placeholder" aria-hidden="true"></div>
                )}
              </div>
              <div class="service-card__content">
                <div class="service-card__copy">
                  <h3 class="service-card__title">{item.title}</h3>
                  {Array.isArray(item.body) && item.body.length > 0 && (
                    <div class="service-card__body rich-text">
                      <PortableText value={item.body} />
                    </div>
                  )}
                </div>
                <a class="button button--raspberry" href={item.buttonHref}>{item.buttonLabel}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
