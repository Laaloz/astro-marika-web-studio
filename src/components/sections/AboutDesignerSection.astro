---
import SanityImage from '../SanityImage.astro';
import {PortableText} from 'astro-portabletext';
import type {PortableTextBlock} from '@portabletext/types';

const {
  eyebrow,
  title,
  body = [],
  ctaLabel,
  ctaHref,
  image,
} = Astro.props as {
  eyebrow?: string;
  title?: string;
  body?: PortableTextBlock[];
  ctaLabel?: string;
  ctaHref?: string;
  image?: {alt?: string};
};

const hasContent = Boolean(eyebrow && title && Array.isArray(body) && body.length > 0);
const hasCta = Boolean(ctaLabel && ctaHref);
---

{
  hasContent && (
<section class="page-section has-background about-designer" aria-label={eyebrow}>
  <div class="about-designer__container">
    <div class="about-designer__content">
      <div class="about-designer__text-wrap">
        <div class="about-designer__heading">
          <div class="about-designer__eyebrow-wrap">
            <span class="about-designer__eyebrow-dot" aria-hidden="true"></span>
            <p class="about-designer__eyebrow">{eyebrow}</p>
          </div>
          <h2 class="about-designer__title">{title}</h2>
        </div>

        <div class="about-designer__body">
          <PortableText value={body} />
        </div>
      </div>

      {hasCta && (
      <a class="button button--primary-brand home-hero__button home-hero__button--primary about-designer__cta" href={ctaHref}>
        <span>{ctaLabel}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
        </svg>
      </a>
      )}
    </div>

    <figure class="about-designer__image-wrap">
      {
        image ? (
          <SanityImage
            image={image}
            alt={image.alt || ''}
            width={521}
            height={635}
            fit="crop"
            widths={[360, 521, 680, 1042, 1280]}
            class="about-designer__image"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 64rem) 33rem, 100vw"
          />
        ) : (
          <div class="about-designer__image about-designer__image--placeholder"></div>
        )
      }
    </figure>
</div>
</section>
  )
}
