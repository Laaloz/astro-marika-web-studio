---
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'

interface FaqItem {
  _key?: string
  question?: string
  answer?: PortableTextBlock[]
}

const {title, body, items = []} = Astro.props as {
  title?: string
  body?: PortableTextBlock[]
  items?: FaqItem[]
}

const hasIntro = Boolean(title && Array.isArray(body) && body.length > 0)
const accordionItems = items.filter(
  (item): item is FaqItem & {question: string; answer: PortableTextBlock[]} =>
    Boolean(item?.question && Array.isArray(item?.answer) && item.answer.length > 0),
)
---

{
  hasIntro && accordionItems.length > 0 && (
    <section
      class="page-section faq-section"
      aria-label={title || 'FAQ'}
    >
      <div class="site-container faq-section__container">
        <div class="faq-section__grid">
          <div class="faq-section__intro">
            <h2 class="faq-section__title">{title}</h2>
            <div class="faq-section__body rich-text">
              <PortableText value={body} />
            </div>
          </div>

          <div class="faq-section__accordion-list">
            {accordionItems.map((item) => (
              <details class="faq-section__accordion-item">
                <summary class="faq-section__summary">
                  <span class="faq-section__summary-label">{item.question}</span>
                  <span class="faq-section__summary-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38" fill="none">
                      <path d="M0 19C0 8.50659 8.50659 0 19 0C29.4934 0 38 8.50659 38 19C38 29.4934 29.4934 38 19 38C8.50659 38 0 29.4934 0 19Z" fill="var(--faq-icon-bg)"/>
                      <path d="M9.27649 19.1917C9.27648 18.8796 9.37824 18.6218 9.58186 18.4181C9.78639 18.2136 10.0448 18.1113 10.3569 18.1113L17.9196 18.1113L17.9196 10.5486C17.9196 10.2364 18.0219 9.9786 18.2264 9.775C18.43 9.57045 18.6879 9.46817 19 9.46817C19.3121 9.46818 19.5704 9.57045 19.775 9.775C19.9786 9.97859 20.0804 10.2364 20.0804 10.5486L20.0804 18.1113L27.6431 18.1113C27.9552 18.1113 28.2131 18.2136 28.4167 18.4181C28.6213 18.6217 28.7236 18.8796 28.7236 19.1917C28.7235 19.5038 28.6213 19.7622 28.4167 19.9667C28.2131 20.1703 27.9553 20.2721 27.6432 20.2721L20.0804 20.2721L20.0804 27.8348C20.0804 28.147 19.9786 28.4052 19.775 28.6099C19.5705 28.8134 19.3121 28.9152 19 28.9152C18.6879 28.9152 18.43 28.8134 18.2264 28.6098C18.0219 28.4052 17.9196 28.1469 17.9196 27.8348L17.9196 20.2721L10.3569 20.2721C10.0448 20.2721 9.78638 20.1703 9.5819 19.9667C9.37823 19.7622 9.2765 19.5038 9.27649 19.1917Z" fill="#322221"/>
                    </svg>
                  </span>
                </summary>
                <div class="faq-section__answer rich-text">
                  <PortableText value={item.answer} />
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
