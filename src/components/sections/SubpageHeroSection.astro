---
import {PortableText} from 'astro-portabletext';
import type {PortableTextBlock} from '@portabletext/types';

const {title, body} = Astro.props as {
	title?: string;
	body?: PortableTextBlock[];
};

const hasBody = Array.isArray(body) && body.length > 0;
const hasContent = Boolean(title);
---

{
	hasContent && (
		<section class="page-section subpage-hero" aria-label={title || 'Hero'}>
			<div class="site-container subpage-hero__container">
				<div class="subpage-hero__header">
					<h1 class="subpage-hero__title">{title}</h1>
					<svg class="subpage-hero__title-icon" viewBox="0 0 37 37" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M31.6755 14.9697C34.968 15.7137 37 16.8637 37 18.5C37 20.1363 34.968 21.2863 31.6755 22.0303C34.155 24.321 35.3398 26.3329 34.5217 27.75C33.7035 29.1671 31.3687 29.147 28.1452 28.145C29.1472 31.3685 29.1673 33.7033 27.7502 34.5215C26.3331 35.3396 24.3211 34.1548 22.0304 31.6752C21.2863 34.9679 20.1363 37 18.5 37C16.8637 37 15.7137 34.968 14.9697 31.6755C12.6791 34.1549 10.6672 35.3396 9.25018 34.5215C7.83311 33.7033 7.85318 31.3685 8.85517 28.145C5.63165 29.147 3.29686 29.1671 2.47871 27.75C1.66057 26.3329 2.84533 24.321 5.32482 22.0303C2.03209 21.2863 -2.78765e-07 20.1363 0 18.5C7.15258e-08 16.8637 2.03209 15.7137 5.32482 14.9696C2.84533 12.679 1.66057 10.6671 2.47871 9.25C3.29686 7.83293 5.63165 7.853 8.85517 8.85499C7.85318 5.63147 7.83311 3.29668 9.25018 2.47853C10.6672 1.6604 12.6791 2.84511 14.9697 5.32452C15.7137 2.03196 16.8637 0 18.5 0C20.1363 0 21.2863 2.03209 22.0304 5.32483C24.3211 2.84521 26.3331 1.66037 27.7502 2.47853C29.1673 3.29668 29.1472 5.63147 28.1452 8.85499C31.3687 7.853 33.7035 7.83293 34.5217 9.25C35.3398 10.6671 34.155 12.679 31.6755 14.9697Z" fill="#477EFF" fill-opacity="0.9" />
					</svg>
				</div>
				{hasBody && (
					<div class="subpage-hero__body rich-text">
						<PortableText value={body} />
					</div>
				)}
			</div>
		</section>
	)
}
