---
import {PortableText} from 'astro-portabletext';
import type {PortableTextBlock} from '@portabletext/types';

const {title, body} = Astro.props as {
  title?: string;
  body?: PortableTextBlock[];
};

const hasContent = Boolean(title && Array.isArray(body) && body.length > 0);
---

{
  hasContent && (
    <section class="page-section has-background subpage-hero" aria-label={title || 'Hero'}>
      <svg
        class="subpage-hero__curve"
        viewBox="0 0 1440 481"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
