---
import {Image} from 'astro:assets'
import type {SanityImageSource} from '@sanity/image-url'
import {type SanityImageFit, urlFor} from '../lib/sanityImage'

interface Props {
  image: SanityImageSource | null | undefined
  alt?: string
  width: number
  height?: number
  fit?: SanityImageFit
  format?: 'avif' | 'webp' | 'png' | 'jpg' | 'jpeg'
  quality?: number
  widths?: number[]
  class?: string
  loading?: 'lazy' | 'eager'
  decoding?: 'async' | 'auto' | 'sync'
  fetchpriority?: 'high' | 'low' | 'auto'
  sizes?: string
}

const {
  image,
  alt = '',
  width,
  height,
  fit,
  format = 'avif',
  quality = 50,
  widths,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  sizes,
} = Astro.props

const imageBuilder = image ? urlFor(image)?.width(width) : null
const imageUrl = imageBuilder
  ? (height ? imageBuilder.height(height) : imageBuilder)
      [fit ? 'fit' : 'url']?.(fit as never) ?? null
  : null

const resolvedUrl = imageUrl && typeof imageUrl !== 'string' ? imageUrl.url() : imageUrl
---

{
  resolvedUrl && (
    <Image
      src={resolvedUrl}
      alt={alt}
      width={width}
      height={height}
      format={format}
      quality={quality}
      widths={widths}
      class={className}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      sizes={sizes}
    />
  )
}
