---
import '../styles/global.css';
import {sanityClient} from 'sanity:client';
import {urlFor} from '../lib/sanityImage';
import SanityImage from '../components/SanityImage.astro';
import type {SanityImageSource} from '@sanity/image-url';

interface ContentMetadata {
	title?: string;
	description?: string;
	image?: string | SanityImageSource;
	canonical?: string;
	noindex?: boolean;
}

interface NavigationLink {
	label?: string;
	href?: string;
}

interface NavigationItem extends NavigationLink {
	submenu?: NavigationLink[];
}

const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim() || '';
const hasGtm = Boolean(gtmId);

const SITE_SETTINGS_QUERY = `*[_type == "siteSettings"][0]{
  siteTitle,
  siteDescription,
  seoTitle,
  seoDescription,
  ogImage,
  logoDesktop,
  logoMobile,
  logoHref,
  mainNavigation[]{
    label,
    href,
    submenu[]{
      label,
      href
    }
  },
  footerInstagramHref,
  footerInstagramLabel,
  footerEmail,
  footerPhone,
  footerCopyright,
  footerPrivacyLabel,
  footerPrivacyHref,
  footerCookiesLabel,
  footerCookiesHref
   
}`;

const siteSettings = await sanityClient.fetch<{
	siteTitle?: string;
	siteDescription?: string;
	seoTitle?: string;
	seoDescription?: string;
	ogImage?: SanityImageSource;
	logoDesktop?: SanityImageSource & { alt?: string };
	logoMobile?: SanityImageSource & { alt?: string };
	logoHref?: string;
	mainNavigation?: NavigationItem[];
	footerInstagramHref?: string;
	footerInstagramLabel?: string;
	footerEmail?: string;
	footerPhone?: string;
	footerCopyright?: string;
	footerPrivacyLabel?: string;
	footerPrivacyHref?: string;
	footerCookiesLabel?: string;
	footerCookiesHref?: string;
} | null>(SITE_SETTINGS_QUERY);

const defaultNavigation: NavigationItem[] = [
	{ label: 'Palvelut', href: '/palvelut', submenu: [] },
	{ label: 'Portfolio', href: '/referenssit' },
	{ label: 'Marika', href: '/marika' },
	{ label: 'Ota yhteyttä', href: '/ota-yhteytta' },
];

const navigation = Array.isArray(siteSettings?.mainNavigation) && siteSettings.mainNavigation.length > 0
	? siteSettings.mainNavigation
	: defaultNavigation;

const headerCtaLabel = 'Ota yhteyttä';
const headerCtaHref = '/ota-yhteytta';
const isHeaderCtaItem = (item: NavigationLink) => {
	const label = (item.label || '').trim().toLowerCase();
	const href = normalizeCmsHref(item.href);
	return label === headerCtaLabel.toLowerCase() || href === headerCtaHref;
};
const headerCtaSource = navigation.find(isHeaderCtaItem);
const headerCta = {
	label: headerCtaSource?.label || headerCtaLabel,
	href: headerCtaSource?.href || headerCtaHref,
};
const desktopNavigation = navigation.filter((item) => !isHeaderCtaItem(item));
const mobileNavigation = navigation.some(isHeaderCtaItem) ? navigation : [...navigation, headerCta];

const logoDesktop = siteSettings?.logoDesktop;
const logoMobile = siteSettings?.logoMobile;
const logoDesktopAlt = siteSettings?.logoDesktop?.alt || siteSettings?.siteTitle || 'Sivuston logo';
const logoMobileAlt = siteSettings?.logoMobile?.alt || siteSettings?.siteTitle || 'Sivuston logo';
const logoDesktopUrl = logoDesktop ? urlFor(logoDesktop)?.url() : undefined;
const logoMobileUrl = logoMobile ? urlFor(logoMobile)?.url() : undefined;
const logoHref = siteSettings?.logoHref || '/';

const footerLogoUrl = logoDesktopUrl;
const footerLogoAlt = logoDesktopAlt;
const footerInstagramHref = siteSettings?.footerInstagramHref;
const footerInstagramLabel = siteSettings?.footerInstagramLabel;
const footerEmail = siteSettings?.footerEmail;
const footerPhone = siteSettings?.footerPhone;
const footerPhoneHref = footerPhone ? `tel:${footerPhone.replace(/[^+\d]/g, '')}` : undefined;
const footerCopyright = siteSettings?.footerCopyright;
const footerPrivacyLabel = siteSettings?.footerPrivacyLabel;
const footerPrivacyHref = siteSettings?.footerPrivacyHref;
const footerCookiesLabel = siteSettings?.footerCookiesLabel;
const footerCookiesHref = siteSettings?.footerCookiesHref || '#cookie-banner';

function normalizeCmsHref(href?: string) {
	if (!href) return '#';
	if (
		href.startsWith('/') ||
		href.startsWith('http') ||
		href.startsWith('mailto:') ||
		href.startsWith('tel:') ||
		href.startsWith('#')
	) {
		return href;
	}
	return `/${href}`;
}

const normalizePath = (path: string) => {
	const plainPath = path.split('#')[0]?.split('?')[0] || '/';
	const trimmed = plainPath.replace(/\/+$/, '');
	return trimmed === '' ? '/' : trimmed;
};

const currentPath = normalizePath(Astro.url.pathname);
const isInternalPath = (href?: string) => {
	const normalizedHref = normalizeCmsHref(href);
	return normalizedHref.startsWith('/');
};
const isCurrentPath = (href?: string) => {
	const normalizedHref = normalizeCmsHref(href);
	return isInternalPath(normalizedHref) && normalizePath(normalizedHref) === currentPath;
};
const menuItemId = (item: NavigationItem) => {
	const source = `${item.label || 'section'}-${item.href || ''}`;
	return source.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'section';
};
const navItemAnchorId = (scope: 'desktop' | 'mobile', index: number) => `${scope}-nav-item-${index}`;

const defaultTitle = siteSettings?.seoTitle || siteSettings?.siteTitle || 'Marika Web Studio';
const defaultDescription =
	siteSettings?.seoDescription ||
	siteSettings?.siteDescription ||
	'Digitaalisia palveluita, joissa tunne ja toimivuus kohtaavat. Verkkosivuja ja visuaalisia kokonaisuuksia, jotka tuntuvat omilta ja herättävät luottamuksen.';

const { content = {} } = Astro.props as { content?: ContentMetadata };

const title = content.title || defaultTitle;
const description = content.description || defaultDescription;
const canonical = content.canonical || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
const socialImageSource = content.image || siteSettings?.ogImage || '/favicon.svg';
const socialImagePath =
	typeof socialImageSource === 'string'
		? socialImageSource
		: urlFor(socialImageSource)?.width(1200).height(630).fit('crop').url();
const socialImageUrl = socialImagePath ? new URL(socialImagePath, Astro.url).href : undefined;

// Preload LCP hero image if it's a Sanity image (not a plain string)
const lcpImageSource = content.image && typeof content.image !== 'string' ? content.image : null;
const lcpPreloadWidths = [320, 420, 527, 640, 1054, 1280, 1600, 2000];
const lcpPreloadSrcset = lcpImageSource
	? lcpPreloadWidths
			.map((w) => {
				const h = Math.round(791 * w / 527);
			return `${urlFor(lcpImageSource)?.width(w).height(h).fit('crop').quality(90).url()} ${w}w`;
			})
			.filter(Boolean)
			.join(', ')
	: null;
---


<html lang="fi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{hasGtm && (
			<script is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag(){window.dataLayer.push(arguments);}

				gtag('consent', 'default', {
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
					analytics_storage: 'denied',
					functionality_storage: 'denied',
					personalization_storage: 'denied',
					security_storage: 'granted',
					wait_for_update: 500,
				});

				const updateConsentFromCookiebot = () => {
					if (!window.Cookiebot || !window.Cookiebot.consent) return;
					const consent = window.Cookiebot.consent;
					gtag('consent', 'update', {
						ad_storage: consent.marketing ? 'granted' : 'denied',
						ad_user_data: consent.marketing ? 'granted' : 'denied',
						ad_personalization: consent.marketing ? 'granted' : 'denied',
						analytics_storage: consent.statistics ? 'granted' : 'denied',
						functionality_storage: consent.preferences ? 'granted' : 'denied',
						personalization_storage: consent.preferences ? 'granted' : 'denied',
						security_storage: 'granted',
					});
				};

				document.addEventListener('CookiebotOnConsentReady', updateConsentFromCookiebot);
				document.addEventListener('CookiebotOnAccept', updateConsentFromCookiebot);
				document.addEventListener('CookiebotOnDecline', updateConsentFromCookiebot);
			</script>
		)}
		{hasGtm && (
			<script is:inline define:vars={{gtmId}}>
				(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
				j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
				'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
				})(window,document,'script','dataLayer',gtmId);
			</script>
		)}
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		{lcpPreloadSrcset && (
			<link
				rel="preload"
				as="image"
				imagesrcset={lcpPreloadSrcset}
				imagesizes="(min-width: 64rem) 38rem, 100vw"
				fetchpriority="high"
			/>
		)}
		{hasGtm && <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fi_FI" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		{content.noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
	</head>
	<body>
		{hasGtm && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
				></iframe>
			</noscript>
		)}
		<a class="skip-link" href="#main-content">Siirry pääsisältöön</a>
		<header class="site-header" role="banner">
			<div class="site-header__desktop">
				<div class="site-container site-header__desktop-inner">
					<a class="site-header__logo site-header__logo--desktop" href={normalizeCmsHref(logoHref)} aria-label="Etusivu">
						{logoDesktopUrl ? (
							<img
								src={logoDesktopUrl}
								alt={logoDesktopAlt}
								width="320"
								height="56"
								class="site-header__logo-image site-header__logo-image--desktop"
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						) : (
							<span class="site-header__logo-fallback">STUDIO MARUZELLA</span>
						)}
					</a>
					<nav aria-label="Päävalikko" class="site-nav site-nav--desktop">
						<ul class="site-nav__list">
							{desktopNavigation.map((item, index) => {
								const hasSubmenu = Array.isArray(item.submenu) && item.submenu.length > 0;
								const submenuHasCurrent = hasSubmenu && item.submenu?.some((subitem) => isCurrentPath(subitem.href));
								const itemActive = isCurrentPath(item.href) || submenuHasCurrent;
								const currentAnchorId = navItemAnchorId('desktop', index);
								const nextAnchorHref =
									index === desktopNavigation.length - 1
										? '#main-content'
										: `#${navItemAnchorId('desktop', index + 1)}`;

								return (
									<li class:list={{ 'site-nav__item': true, 'site-nav__item--has-submenu': hasSubmenu }}>
										<a
											id={currentAnchorId}
											class:list={{ 'site-nav__link': true, 'site-nav__link--active': itemActive }}
											href={normalizeCmsHref(item.href)}
											aria-current={isCurrentPath(item.href) ? 'page' : undefined}
										>
											<span>{item.label || 'Linkki'}</span>
											{hasSubmenu && (
												<svg class="site-nav__caret" viewBox="0 0 24 24" aria-hidden="true">
													<path d="M6 9L12 15L18 9" />
												</svg>
											)}
										</a>
						{hasSubmenu && (
							<div class="site-subnav" aria-label={`${item.label || 'Alavalikko'} alavalikko`}>
								{desktopNavigation.length > 1 && (
									<a class="site-subnav__skip" href={nextAnchorHref}>
										Ohita tämän alavalikon linkit
									</a>
								)}
								<ul class="site-subnav__links">
													{item.submenu?.map((subitem) => (
														<li>
															<a
																class="site-subnav__link"
														href={normalizeCmsHref(subitem.href)}
																aria-current={isCurrentPath(subitem.href) ? 'page' : undefined}
															>
																{subitem.label || 'Alalinkki'}
															</a>
														</li>
													))}
												</ul>
											</div>
										)}
									</li>
								);
							})}
						</ul>
					</nav>
					<a class="site-header__cta" href={normalizeCmsHref(headerCta.href)}>
						<span>{headerCta.label}</span>
						<svg class="site-header__cta-icon" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M16.627 12.75H4.5V11.25H16.627L10.9308 5.55375L12 4.5L19.5 12L12 19.5L10.9308 18.4462L16.627 12.75Z" />
						</svg>
					</a>
				</div>
			</div>

			<div class="site-header__mobile" data-mobile-nav>
				<div class="site-container site-header__mobile-bar">
					<a class="site-header__logo site-header__logo--mobile" href={normalizeCmsHref(logoHref)} aria-label="Etusivu">
						{logoMobileUrl ? (
							<img
								src={logoMobileUrl}
								alt={logoMobileAlt}
								width="56"
								height="30"
								class="site-header__logo-image site-header__logo-image--mobile"
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						) : (
							<span class="site-header__logo-fallback">SM</span>
						)}
					</a>
					<button
						type="button"
						class="site-header__mobile-trigger"
						data-mobile-nav-trigger
						aria-controls="mobile-menu"
						aria-expanded="false"
					>
						<span class="sr-only">Avaa päävalikko</span>
						<span class="site-header__hamburger" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</button>
				</div>
				<nav id="mobile-menu" class="mobile-nav" aria-label="Päävalikko mobiili" hidden>
					<ul class="mobile-nav__list site-container">
						<li>
							<a class="mobile-nav__link" href={normalizeCmsHref(logoHref)} aria-current={isCurrentPath(logoHref) ? 'page' : undefined}>
								Etusivu
							</a>
						</li>
						{mobileNavigation.map((item, index) => {
							const hasSubmenu = Array.isArray(item.submenu) && item.submenu.length > 0;
							const submenuHasCurrent = hasSubmenu && item.submenu?.some((subitem) => isCurrentPath(subitem.href));
							const itemActive = isCurrentPath(item.href) || submenuHasCurrent;
							const submenuId = `mobile-submenu-${menuItemId(item)}`;
							const currentAnchorId = navItemAnchorId('mobile', index);
							const nextAnchorHref =
								index === mobileNavigation.length - 1
									? '#main-content'
									: `#${navItemAnchorId('mobile', index + 1)}`;

							if (!hasSubmenu) {
								return (
									<li>
										<a
											id={currentAnchorId}
											class:list={{ 'mobile-nav__link': true, 'mobile-nav__link--active': itemActive }}
											href={normalizeCmsHref(item.href)}
											aria-current={isCurrentPath(item.href) ? 'page' : undefined}
										>
											{item.label || 'Linkki'}
										</a>
									</li>
								);
							}

							return (
								<li>
									<details class="mobile-subnav" open={submenuHasCurrent} data-mobile-subnav>
										<summary
											id={currentAnchorId}
											class:list={{ 'mobile-subnav__summary': true, 'mobile-subnav__summary--active': itemActive }}
											aria-controls={submenuId}
										>
											<a
												class:list={{ 'mobile-nav__link': true, 'mobile-nav__link--active': itemActive, 'mobile-subnav__parent-link': true }}
												href={normalizeCmsHref(item.href)}
												aria-current={isCurrentPath(item.href) ? 'page' : undefined}
											>
												{item.label || 'Alavalikko'}
											</a>
											<svg class="mobile-subnav__caret" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M6 9L12 15L18 9" />
											</svg>
										</summary>
										{mobileNavigation.length > 1 && (
											<a class="mobile-subnav__skip" href={nextAnchorHref}>
												Ohita tämän alavalikon linkit
											</a>
										)}
										<ul id={submenuId} class="mobile-subnav__list" aria-label={`${item.label || 'Alavalikko'} alavalikko`}>
											{item.submenu?.map((subitem) => (
												<li>
													<a
														class="mobile-subnav__link"
														href={normalizeCmsHref(subitem.href)}
														aria-current={isCurrentPath(subitem.href) ? 'page' : undefined}
													>
														{subitem.label || 'Alalinkki'}
													</a>
												</li>
											))}
										</ul>
									</details>
								</li>
							);
						})}
					</ul>
				</nav>
			</div>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer class="site-footer" aria-label="Alatunniste">
			<div class="site-container site-footer__inner">
				<div class="site-footer__logo-wrap">
					{footerLogoUrl && (
						<SanityImage
							image={logoDesktop || logoMobile}
							alt={footerLogoAlt}
							width={654}
							height={118}
							fit="max"
							quality={90}
							widths={[360, 654, 900, 1200]}
							class="site-footer__logo"
							loading="lazy"
							decoding="async"
							sizes="(min-width: 64rem) 41rem, 100vw"
						/>
					)}
				</div>

				<div class="site-footer__contact-grid" aria-label="Yhteystiedot">
					<div class="site-footer__row">
						<a class="site-footer__item site-footer__item--social" href={footerInstagramHref} aria-label={footerInstagramLabel}>
							<svg class="site-footer__instagram-icon" viewBox="0 0 18 18" aria-hidden="true">
								<rect x="1.5" y="1.5" width="15" height="15" rx="4" ry="4" fill="none" stroke="currentColor" stroke-width="1.5" />
								<circle cx="9" cy="9" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5" />
								<circle cx="13.2" cy="4.8" r="0.9" fill="currentColor" />
							</svg>
							<span>{footerInstagramLabel}</span>
						</a>
						<a class="site-footer__item" href={`mailto:${footerEmail}`}>{footerEmail}</a>
						<a class="site-footer__item" href={footerPhoneHref}>{footerPhone}</a>
						<span class="site-footer__item site-footer__item--spacer" aria-hidden="true"></span>
					</div>
					<div class="site-footer__row">
						<span class="site-footer__item">{footerCopyright}</span>
						<a class="site-footer__item" href={footerPrivacyHref}>{footerPrivacyLabel}</a>
						<a
							class="site-footer__item"
							href={normalizeCmsHref(footerCookiesHref)}
							data-cookie-preferences={normalizeCmsHref(footerCookiesHref) === '#cookie-banner' ? '' : undefined}
						>{footerCookiesLabel}</a>
						<span class="site-footer__item site-footer__item--spacer" aria-hidden="true"></span>
					</div>
				</div>
			</div>
		</footer>
		<script is:inline>
			const header = document.querySelector('.site-header');

			const alignDesktopSubmenus = () => {
				const desktopItems = document.querySelectorAll('.site-nav__item--has-submenu');
				desktopItems.forEach((item) => {
					if (!(item instanceof HTMLElement)) return;
					const submenu = item.querySelector('.site-subnav');
					if (!(submenu instanceof HTMLElement)) return;

					item.removeAttribute('data-submenu-align');
					submenu.style.setProperty('--submenu-shift', '0px');
					submenu.style.visibility = 'hidden';
					submenu.style.display = 'grid';
					submenu.style.left = '0';
					submenu.style.right = 'auto';

					const viewportPadding = 16;
					let bounds = submenu.getBoundingClientRect();
					if (bounds.right > window.innerWidth - viewportPadding) {
						item.setAttribute('data-submenu-align', 'right');
						submenu.style.left = 'auto';
						submenu.style.right = '0';
						bounds = submenu.getBoundingClientRect();
					}

					if (bounds.left < viewportPadding) {
						const shift = viewportPadding - bounds.left;
						submenu.style.setProperty('--submenu-shift', `${Math.ceil(shift)}px`);
					}

					bounds = submenu.getBoundingClientRect();
					if (bounds.right > window.innerWidth - viewportPadding) {
						const shift = (window.innerWidth - viewportPadding) - bounds.right;
						submenu.style.setProperty('--submenu-shift', `${Math.floor(shift)}px`);
					}

					submenu.style.removeProperty('left');
					submenu.style.removeProperty('right');
					submenu.style.removeProperty('display');
					submenu.style.removeProperty('visibility');
				});
			};

			const mobileNav = document.querySelector('[data-mobile-nav]');
			if (mobileNav instanceof HTMLElement) {
				const trigger = mobileNav.querySelector('[data-mobile-nav-trigger]');
				const mobileMenu = mobileNav.querySelector('#mobile-menu');
				const mobileSubmenus = mobileNav.querySelectorAll('[data-mobile-subnav]');
				let isOpen = false;
				const setScrollLock = () => {
					document.documentElement.classList.toggle('mobile-nav-open', isOpen);
					document.body.classList.toggle('mobile-nav-open', isOpen);
				};
				const closeMobileNav = (focusTrigger = false) => {
					isOpen = false;
					mobileNav.classList.remove('is-open');
					if (mobileMenu instanceof HTMLElement) mobileMenu.hidden = true;
					if (trigger instanceof HTMLElement) trigger.setAttribute('aria-expanded', 'false');
					mobileSubmenus.forEach((submenu) => {
						if (submenu instanceof HTMLDetailsElement) submenu.open = false;
					});
					setScrollLock();
					if (focusTrigger && trigger instanceof HTMLElement) trigger.focus();
				};
				const openMobileNav = () => {
					isOpen = true;
					mobileNav.classList.add('is-open');
					if (mobileMenu instanceof HTMLElement) mobileMenu.hidden = false;
					if (trigger instanceof HTMLElement) trigger.setAttribute('aria-expanded', 'true');
					setScrollLock();
				};
				const setExpanded = () => {
					header?.classList.toggle('site-header--mobile-open', isOpen);
					setScrollLock();
				};
				const setMobileHeaderHeight = () => {
					const mobileBar = mobileNav.querySelector('.site-header__mobile-bar');
					if (!(mobileBar instanceof HTMLElement)) return;
					const mobileHeaderHeight = `${Math.ceil(mobileBar.getBoundingClientRect().height)}px`;
					mobileNav.style.setProperty('--mobile-header-height', mobileHeaderHeight);
					document.documentElement.style.setProperty('--mobile-header-height', mobileHeaderHeight);
				};
				setExpanded();
				setMobileHeaderHeight();
				if (trigger instanceof HTMLElement) {
					trigger.addEventListener('click', () => {
						if (isOpen) {
							closeMobileNav();
						} else {
							openMobileNav();
						}
						setExpanded();
					});
				}
				mobileSubmenus.forEach((submenu) => {
					if (!(submenu instanceof HTMLDetailsElement)) return;
					const summary = submenu.querySelector('summary');
					if (summary instanceof HTMLElement) {
						summary.addEventListener('click', (event) => {
							const target = event.target;
							if (!(target instanceof Element)) return;
							const parentLink = target.closest('.mobile-subnav__parent-link');
							if (!(parentLink instanceof HTMLAnchorElement)) return;
							event.preventDefault();
							event.stopPropagation();
							window.location.href = parentLink.href;
						});
					}
					submenu.addEventListener('toggle', () => {
						if (!submenu.open) return;
						mobileSubmenus.forEach((other) => {
							if (other !== submenu && other instanceof HTMLDetailsElement) other.open = false;
						});
					});
				});
				window.addEventListener('resize', setMobileHeaderHeight);
				window.addEventListener('resize', () => {
					if (window.matchMedia('(min-width: 64rem)').matches && isOpen) {
						closeMobileNav();
					}
					setScrollLock();
				});
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && isOpen) {
						const openSubmenu = Array.from(mobileSubmenus).find(
							(item) => item instanceof HTMLDetailsElement && item.open
						);
						if (openSubmenu instanceof HTMLDetailsElement) {
							openSubmenu.open = false;
							const openSummary = openSubmenu.querySelector('summary');
							if (openSummary instanceof HTMLElement) openSummary.focus();
						} else {
							closeMobileNav(true);
							setExpanded();
						}
					}
				});
			}

			alignDesktopSubmenus();
			window.addEventListener('resize', alignDesktopSubmenus);

			const cookiePreferenceLinks = document.querySelectorAll('[data-cookie-preferences]');
			cookiePreferenceLinks.forEach((link) => {
				if (!(link instanceof HTMLAnchorElement)) return;
				link.addEventListener('click', (event) => {
					event.preventDefault();
					if (window.Cookiebot && typeof window.Cookiebot.renew === 'function') {
						window.Cookiebot.renew();
					}
				});
			});
		</script>
	</body>
	</html>
