---
import type {SanityDocument} from '@sanity/client';
import MainLayout from '../layouts/main.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import {sanityClient} from 'sanity:client';

const PAGE_QUERY = `*[_type == "page" && slug.current == $slug][0]{
  title,
  pageBuilder[]{
    ...,
    _type == "heroSection" => {
      ...,
      image {
        ...,
        alt
      }
    }
  }
}`;

export async function getStaticPaths(): Promise<{params: {slug: string}}[]> {
  return await sanityClient.fetch(`*[_type == "page" && defined(slug.current)]{
    "params": {"slug": slug.current}
  }`);
}

const page = await sanityClient.fetch<SanityDocument | null>(PAGE_QUERY, Astro.params);
---

<MainLayout content={{title: `${page?.title || 'Page'} | Marika Web Studio`}}>
	<main class="page-shell page-shell--builder">
		{(page?.pageBuilder || []).map((block: SanityDocument) => {
			if (block._type === 'heroSection') {
				return <HeroSection {...block} />;
			}

			return null;
		})}
	</main>
</MainLayout>
