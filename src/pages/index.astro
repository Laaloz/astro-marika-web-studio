---
import type {SanityDocument} from '@sanity/client';
import MainLayout from '../layouts/main.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ScrollingTextSection from '../components/sections/ScrollingTextSection.astro';
import ServiceHighlightsSection from '../components/sections/ServiceHighlightsSection.astro';
import DesignAndImplementationSection from '../components/sections/DesignAndImplementationSection.astro';
import AboutDesignerSection from '../components/sections/AboutDesignerSection.astro';
import ReferenceSection from '../components/sections/ReferenceSection.astro';
import {sanityClient} from 'sanity:client';

const HOMEPAGE_QUERY = `*[_type == "page" && slug.current in ["home", "etusivu"]][0]{
  title,
  "metaDescription": pageBuilder[_type == "heroSection"][0].description,
  "metaImage": pageBuilder[_type == "heroSection"][0].image,
  pageBuilder[]{
    ...,
    _type == "heroSection" => {
      ...,
      image {
        ...,
        alt
      }
    },
    _type == "referenceSection" => {
      ...,
      references[]-> {
        _id,
        title,
        slug,
        image {
          ...,
          alt
        }
      }
    }
  }
}`;

const homepage = await sanityClient.fetch<SanityDocument | null>(HOMEPAGE_QUERY);
---


<MainLayout content={{ title: `${homepage?.title || 'Marika Web Studio'} | Marika Web Studio`, description: homepage?.metaDescription, image: homepage?.metaImage }}>
	<main class="page-shell page-shell--hero">
		{(homepage?.pageBuilder || []).map((block: SanityDocument) => {
			if (block._type === 'heroSection') {
				return <HeroSection {...block} />;
			}

			if (block._type === 'scrollingTextSection') {
				return <ScrollingTextSection {...block} />;
			}

			if (block._type === 'serviceHighlightsSection') {
				return <ServiceHighlightsSection {...block} />;
			}

			if (block._type === 'designAndImplementationSection') {
				return <DesignAndImplementationSection {...block} />;
			}

			if (block._type === 'aboutDesignerSection') {
				return <AboutDesignerSection {...block} />;
			}

			if (block._type === 'referenceSection') {
				return <ReferenceSection {...block} />;
			}

			return null;
		})}
	</main>
</MainLayout>
