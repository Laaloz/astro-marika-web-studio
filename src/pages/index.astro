---
import type {SanityDocument} from '@sanity/client';
import MainLayout from '../layouts/main.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import {sanityClient} from 'sanity:client';

const HOMEPAGE_QUERY = `*[_type == "page" && slug.current in ["home", "etusivu"]][0]{
  title,
  pageBuilder[]{
    ...,
    _type == "heroSection" => {
      ...,
      image {
        ...,
        alt
      }
    }
  }
}`;

const homepage = await sanityClient.fetch<SanityDocument | null>(HOMEPAGE_QUERY);
---


<MainLayout content={{ title: `${homepage?.title || 'Marika Web Studio'} | Marika Web Studio` }}>
	<main class="page-shell">
		{(homepage?.pageBuilder || []).map((block: SanityDocument) => {
			if (block._type === 'heroSection') {
				return <HeroSection {...block} />;
			}

			return null;
		})}
	</main>
</MainLayout>
