---
import type {SanityDocument} from '@sanity/client';
import MainLayout from '../layouts/main.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SubpageHeroSection from '../components/sections/SubpageHeroSection.astro';
import ServiceHighlightsSection from '../components/sections/ServiceHighlightsSection.astro';
import FiftyFiftyHighlightsSection from '../components/sections/FiftyFiftyHighlightsSection.astro';
import FiftyFiftySimpleSection from '../components/sections/FiftyFiftySimpleSection.astro';
import TwoColumnContentSection from '../components/sections/TwoColumnContentSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import PackageShowcaseSection from '../components/sections/PackageShowcaseSection.astro';
import LargeImageSection from '../components/sections/LargeImageSection.astro';
import ImageGallerySection from '../components/sections/ImageGallerySection.astro';
import ProjectStepsSection from '../components/sections/ProjectStepsSection.astro';
import AboutDesignerSection from '../components/sections/AboutDesignerSection.astro';
import ReferenceSection from '../components/sections/ReferenceSection.astro';
import CallToActionSection from '../components/sections/CallToActionSection.astro';
import ContactFormSection from '../components/sections/ContactFormSection.astro';
import ContactLinksSection from '../components/sections/ContactLinksSection.astro';
import CenteredRichTextSection from '../components/sections/CenteredRichTextSection.astro';
import CookieDeclarationSection from '../components/sections/CookieDeclarationSection.astro';
import {sanityClient} from 'sanity:client';

const PAGE_QUERY = `*[_type == "page" && slug.current in [$slug, $slugWithLeading, $slugWithTrailing]][0]{
  title,
  "metaDescription": coalesce(seoDescription, pageBuilder[_type == "heroSection"][0].description),
  "metaImage": pageBuilder[_type == "heroSection"][0].image,
  pageBuilder[]{
    ...,
    _type == "heroSection" => {
      ...,
      image {
        ...,
        alt
      }
    },
    _type == "referenceSection" => {
      ...,
      "references": select(
        referenceSelectionMode == "automatic" => *[_type == "referenceItem" && defined(slug.current)] | order(_createdAt desc) {
          _id,
          title,
          slug,
          areas,
          image {
            ...,
            alt
          }
        },
        references[]-> {
          _id,
          title,
          slug,
          areas,
          image {
            ...,
            alt
          }
        }
      )
    }
  }
}`;

export async function getStaticPaths(): Promise<{params: {slug: string}}[]> {
  const pages = await sanityClient.fetch<Array<{slug?: string}>>(
    `*[_type == "page" && defined(slug.current)]{ "slug": slug.current }`
  )

  const slugs = Array.from(
    new Set(
      pages
        .map((page) => (typeof page.slug === 'string' ? page.slug.trim().replace(/^\/+|\/+$/g, '') : ''))
        .filter(Boolean)
    )
  )

  return slugs.map((slug) => ({params: {slug}}))
}

const routeSlug = typeof Astro.params.slug === 'string' ? Astro.params.slug.trim().replace(/^\/+|\/+$/g, '') : ''
const page = await sanityClient.fetch<SanityDocument | null>(PAGE_QUERY, {
  slug: routeSlug,
  slugWithLeading: `/${routeSlug}`,
  slugWithTrailing: `${routeSlug}/`,
});
---

<MainLayout content={{title: `${page?.title || 'Page'} | Marika Web Studio`, description: page?.metaDescription, image: page?.metaImage}}>
		{(page?.pageBuilder || []).map((block: SanityDocument) => {
			if (block._type === 'subpageHeroSection') {
				return <SubpageHeroSection {...block} />;
			}

			if (block._type === 'heroSection') {
				return <HeroSection {...block} />;
			}

			if (block._type === 'serviceHighlightsSection') {
				return <ServiceHighlightsSection {...block} />;
			}

			if (block._type === 'fiftyFiftyHighlightsSection') {
				return <FiftyFiftyHighlightsSection {...block} />;
			}

			if (block._type === 'fiftyFiftySimpleSection') {
				return <FiftyFiftySimpleSection {...block} />;
			}

			if (block._type === 'twoColumnContentSection') {
				return <TwoColumnContentSection {...block} />;
			}

			if (block._type === 'faqSection') {
				return <FaqSection {...block} />;
			}

			if (block._type === 'packageShowcaseSection') {
				return <PackageShowcaseSection {...block} />;
			}

			if (block._type === 'largeImageSection') {
				return <LargeImageSection {...block} />;
			}

			if (block._type === 'imageGallerySection') {
				return <ImageGallerySection {...block} />;
			}

			if (block._type === 'projectStepsSection') {
				return <ProjectStepsSection {...block} />;
			}

			if (block._type === 'aboutDesignerSection') {
				return <AboutDesignerSection {...block} />;
			}

			if (block._type === 'referenceSection') {
				return <ReferenceSection {...block} />;
			}

			if (block._type === 'callToActionSection') {
				return <CallToActionSection {...block} />;
			}

			if (block._type === 'contactFormSection') {
				return <ContactFormSection {...block} />;
			}

			if (block._type === 'contactLinksSection') {
				return <ContactLinksSection {...block} />;
			}

			if (block._type === 'centeredRichTextSection') {
				return <CenteredRichTextSection {...block} />;
			}

			if (block._type === 'cookieDeclarationSection') {
				return <CookieDeclarationSection {...block} />;
			}

			return null;
		})}
</MainLayout>
