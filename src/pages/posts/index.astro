---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import MainLayout from "../../layouts/main.astro";

const POSTS_QUERY = `*[
  _type == "post"
  && defined(slug.current)
]|order(publishedAt desc)[0...12]{_id, title, slug, publishedAt}`;

const posts = await sanityClient.fetch<SanityDocument[]>(POSTS_QUERY);
---

<MainLayout content={{ title: 'Posts | Marika Web Studio', description: 'Sanity-postaukset käyttävät samaa layout- ja typografiafoundationia kuin muu sivusto.' }}>
  <main class="page-shell">
    <section class="surface-panel surface-panel--hero">
      <div class="section-head">
        <p class="eyebrow">Sanity Content</p>
        <h1>Posts</h1>
        <p class="lede">Sanity-postaukset käyttävät nyt samaa layout- ja typografiafoundationia kuin styleguide.</p>
      </div>
      <div class="actions-row">
        <a class="button button--secondary" href="/">Etusivu</a>
        <a class="button button--primary" href="/styleguide">Styleguide</a>
      </div>
    </section>

    <section class="surface-panel">
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a class="post-link-card" href={`/posts/${post.slug.current}`}>
                  <p class="eyebrow">Post</p>
                  <h3>{post.title}</h3>
                  <p class="post-meta">{new Date(post.publishedAt).toLocaleDateString('fi-FI')}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Postauksia ei löytynyt vielä.</p>
        )
      }
    </section>
  </main>
</MainLayout>
