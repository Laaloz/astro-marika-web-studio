---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import MainLayout from '../layouts/main.astro';
import {QUESTIONS, STYLE_KEYS} from '../lib/tyylitesti';
import '../styles/tyylitesti.css';

import kaupunkiItalia from '../assets/tyylitesti/kaupunki-italia.webp';
import metsa from '../assets/tyylitesti/metsa.webp';
import kaupunkiIlta from '../assets/tyylitesti/kaupunki-ilta.webp';
import jarvi from '../assets/tyylitesti/jarvi.webp';

const IMAGES: Record<string, ImageMetadata> = {
	'kaupunki-italia': kaupunkiItalia,
	metsa,
	'kaupunki-ilta': kaupunkiIlta,
	jarvi,
};

const INSTAGRAM_URL = 'https://www.instagram.com/studiomaura.design/';

const LOADER_COLORS = ['#FCD0CD', '#CEE0FB', '#D1C360', '#FFF7EC'];
const loaderCells = Array.from({length: 16}, (_, index) => ({
	color: LOADER_COLORS[index % 4],
	delay: ((index * 7) % 16) * 110,
	round: index % 5 === 0,
}));

const content = {
	title: 'Millainen on sun yrityksen maailma? | Studio Maura',
	description:
		'Testi palvelualan yrittäjälle: vastaa 5 kysymykseen, niin näet, millainen tunnelma sun kotisivuille kuuluu.',
};
---

<MainLayout content={content}>
	<div class="tyylitesti" data-tyylitesti>
		<div class="tyylitesti__progress" data-progress hidden>
			<div class="tyylitesti__progress-row">
				<span class="tyylitesti__progress-label" data-progress-label aria-live="polite">1/5</span>
			</div>
			<div
				class="tyylitesti__progress-track"
				role="progressbar"
				aria-label="Testin eteneminen"
				aria-valuemin="0"
				aria-valuemax="5"
				aria-valuenow="1"
				data-progress-bar
			>
				<div class="tyylitesti__progress-fill" data-progress-fill></div>
			</div>
		</div>

		<div class="tyylitesti__stage" tabindex="-1" data-stage>
			<section class="tyylitesti__intro" data-step="0">
				<p class="tyylitesti__label tyylitesti__label--wine">Palvelualan yrittäjälle</p>
				<h1 class="tyylitesti__title">Millainen on sun yrityksen <em>maailma</em>?</h1>
				<p class="tyylitesti__lead">
					Saat alle minuutissa visuaalista suuntaa someen ja kotisivuille, joka välittää jo etukäteen, miltä palvelusi
					tuntuu ja millainen olo siitä jää.
				</p>
				<p class="tyylitesti__body">Tämä tunne ratkaisee, siirtyykö ihanneasiakkaasi selaamisesta ajanvaraukseen.</p>
				<p class="tyylitesti__body">
					Vastaa 5 kysymykseen ja saat ehdotuksen väreistä ja muodoista, jotka tukevat palvelusi tunnelmaa.
				</p>
				<div class="tyylitesti__start">
					<button type="button" class="tyylitesti__button" data-start>Aloita testi</button>
				</div>
				<noscript>
					<p class="tyylitesti__body">
						Testi tarvitsee toimiakseen JavaScriptin. Voit myös laittaa mulle viestiä Instagramissa:
						<a href={INSTAGRAM_URL} rel="noopener">@studiomaura.design</a>
					</p>
				</noscript>
			</section>

			{
				QUESTIONS.map((question, questionIndex) => (
					<section class="tyylitesti__question" data-step={questionIndex + 1} hidden>
						<button type="button" class="tyylitesti__back" data-back>
							← Edellinen
						</button>
						<span class="tyylitesti__label tyylitesti__label--wine">Kysymys {questionIndex + 1}</span>
						<h2 class="tyylitesti__question-title">{question.pre}<em>{question.em}</em>{question.post}</h2>

						{question.type === 'text' ? (
							<div class="tyylitesti__options">
								{question.options.map((option, optionIndex) => (
									<button
										type="button"
										class="tyylitesti__option"
										aria-pressed="false"
										data-pick={STYLE_KEYS[optionIndex]}
									>
										{option.label}
									</button>
								))}
							</div>
						) : (
							<div class="tyylitesti__image-grid" data-image-grid>
								{question.options.map((option, optionIndex) => (
									<button
										type="button"
										class="tyylitesti__image-option"
										aria-pressed="false"
										aria-label={option.label}
										title={option.label}
										data-pick={STYLE_KEYS[optionIndex]}
									>
										<Image
											src={IMAGES[option.image!]}
											alt=""
											widths={[320, 640, 800]}
											sizes="(max-width: 688px) 50vw, 314px"
											loading="lazy"
											decoding="async"
											format="webp"
										/>
										<span class="tyylitesti__image-name">{option.short}</span>
									</button>
								))}
							</div>
						)}
					</section>
				))
			}

			<section class="tyylitesti__email" data-step="6" hidden>
				<h2 class="tyylitesti__email-title">Melkein valmista!</h2>
				<p class="tyylitesti__body">Kerro sun sähköposti ja yrityksen nimi, niin näet sun tuloksen heti.</p>

				<!-- Netlify Forms tallentaa vastaukset ja lähettää niistä ilmoituksen sähköpostiin. -->
				<form
					class="tyylitesti__form"
					name="tyylitesti"
					method="POST"
					novalidate
					netlify
					data-netlify="true"
					netlify-honeypot="website"
					data-email-form
				>
					<input type="hidden" name="form-name" value="tyylitesti" />
					<input type="hidden" name="world" />
					<input type="hidden" name="keyword" />
					<input type="hidden" name="timestamp" />
					<div class="tyylitesti__field">
						<label for="tyylitesti-email">Sähköposti</label>
						<input
							id="tyylitesti-email"
							name="email"
							type="email"
							required
							autocomplete="email"
							inputmode="email"
							aria-describedby="tyylitesti-email-error"
						/>
						<p class="tyylitesti__error" id="tyylitesti-email-error" hidden>Tarkistatko vielä sähköpostin?</p>
					</div>

					<div class="tyylitesti__field">
						<label for="tyylitesti-company">Yrityksen nimi</label>
						<input
							id="tyylitesti-company"
							name="companyName"
							type="text"
							required
							maxlength="200"
							autocomplete="organization"
							aria-describedby="tyylitesti-company-error"
						/>
						<p class="tyylitesti__error" id="tyylitesti-company-error" hidden>Kirjoitathan yrityksen nimen.</p>
					</div>

					<div class="tyylitesti__honeypot" aria-hidden="true">
						<label for="tyylitesti-website">Verkkosivu</label>
						<input id="tyylitesti-website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>

					<button type="submit" class="tyylitesti__button tyylitesti__email-submit">Näytä mun tulos</button>
				</form>

				<p class="tyylitesti__small">
					Sun tiedot on turvassa, enkä jaa niitä kenellekään.
					<a href="/tietosuoja/" target="_blank" rel="noopener">Tietosuojaseloste</a>
				</p>
				<button type="button" class="tyylitesti__restart tyylitesti__email-back" data-back>
					← Takaisin viimeiseen kysymykseen
				</button>
			</section>

			<section class="tyylitesti__loading" data-step="7" aria-live="polite" hidden>
				<div class="tyylitesti__loader" aria-hidden="true">
					{
						loaderCells.map((cell) => (
							<span class="tyylitesti__loader-cell">
								<span
									class:list={['tyylitesti__loader-fill', {'is-round': cell.round}]}
									style={`background:${cell.color};animation-delay:${cell.delay}ms`}
								/>
							</span>
						))
					}
				</div>
				<p class="tyylitesti__loading-text">Kootaan sun <em>maailmaa</em>…</p>
			</section>

			<section class="tyylitesti__result" data-step="8" hidden>
				<div class="tyylitesti__result-section tyylitesti__result-head">
					<h1 class="tyylitesti__result-title" data-world></h1>
					<p class="tyylitesti__italic" data-tagline></p>
				</div>

				<div class="tyylitesti__result-section">
					<h2 class="tyylitesti__section-title">Millaisen mielikuvan välität?</h2>
					<p class="tyylitesti__italic" data-impression></p>
				</div>

				<div class="tyylitesti__result-section">
					<h2 class="tyylitesti__section-title">Värimaailma</h2>
					<p class="tyylitesti__body">Suuntaa-antava väripaletti:</p>
					<div class="tyylitesti__swatches" aria-hidden="true" data-swatches></div>
					<ul class="tyylitesti__swatch-list" data-swatch-list></ul>
					<p class="tyylitesti__body" data-palette-note></p>
				</div>

				<div class="tyylitesti__result-section">
					<h2 class="tyylitesti__section-title">Typografia</h2>
					<p class="tyylitesti__body" data-typography></p>
				</div>

				<div class="tyylitesti__result-section">
					<h2 class="tyylitesti__section-title">Muodot ja elementit</h2>
					<p class="tyylitesti__body" data-shapes></p>
				</div>

				<div class="tyylitesti__result-section">
					<h2 class="tyylitesti__section-title">Kuvamaailma</h2>
					<p class="tyylitesti__body" data-images></p>
				</div>

				<div class="tyylitesti__result-section">
					<h2 class="tyylitesti__section-title">Kokeile tätä omilla nettisivuillasi</h2>
					<p class="tyylitesti__body" data-try></p>
				</div>

				<div class="tyylitesti__result-section tyylitesti__ending">
					<h2 class="tyylitesti__ending-title">Tämä on vasta alkua!</h2>
					<p class="tyylitesti__body">
						Muista, ettei visuaalisen ilmeen tarvitse syntyä kerralla valmiiksi. Nämä ehdotukset ovat suuntaa antavaa
						inspiraatiota, eivät sääntöjä, joita sinun pitäisi noudattaa pilkulleen.
					</p>
					<p class="tyylitesti__body">
						Poimi mukaan ne värit, muodot ja ideat, jotka tuntuvat omilta. Voit myös yhdistellä eri tyylien elementtejä ja
						löytää sitä kautta jotain ihan omanlaistasi.
					</p>
					<p class="tyylitesti__body">
						Tärkeintä on, että yrityksesi visuaalinen ilme tuntuu omalta ja tukee sitä mielikuvaa, jonka haluat asiakkaillesi
						välittää.
					</p>
					<p class="tyylitesti__italic">Pienistä oivalluksista syntyy usein jotain todella oman näköistä. 🤎</p>
					<p class="tyylitesti__signature">– Studio Maura</p>
				</div>
			</section>
		</div>
	</div>
</MainLayout>

<script>
	import {KEYWORDS, QUESTION_COUNT, RESULTS, WORLD_IDS, isValidEmail, scoreAnswers} from '../lib/tyylitesti';
	import type {Answers, StyleKey} from '../lib/tyylitesti';

	const STEP_INTRO = 0;
	const STEP_EMAIL = 6;
	const STEP_LOADING = 7;
	const STEP_RESULT = 8;
	const FORM_URL = '/tyylitesti/';
	const SUBSCRIBE_URL = '/api/tyylitesti/subscribe';
	const AUTO_ADVANCE_MS = 550;
	const LOADING_MS = 2200;
	const LOADING_MS_REDUCED = 600;
	const IMAGE_QUESTION = 4;

	const root = document.querySelector<HTMLElement>('[data-tyylitesti]');
	if (root) initQuiz(root);

	function initQuiz(root: HTMLElement) {
		const stage = root.querySelector<HTMLElement>('[data-stage]')!;
		const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
		const progress = root.querySelector<HTMLElement>('[data-progress]')!;
		const progressLabel = root.querySelector<HTMLElement>('[data-progress-label]')!;
		const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]')!;
		const progressFill = root.querySelector<HTMLElement>('[data-progress-fill]')!;
		const emailForm = root.querySelector<HTMLFormElement>('[data-email-form]')!;
		const emailInput = emailForm.elements.namedItem('email') as HTMLInputElement;
		const companyInput = emailForm.elements.namedItem('companyName') as HTMLInputElement;
		const honeypotInput = emailForm.elements.namedItem('website') as HTMLInputElement;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let step = STEP_INTRO;
		let answers: Answers = {};
		let autoTimer: number | undefined;
		let loadingTimer: number | undefined;
		let trackedResult = '';
		// Tulokseen pääsee vasta, kun lomake on lähetetty näillä vastauksilla.
		let formSubmitted = false;
		let lastSent = '';

		const clearTimers = () => {
			window.clearTimeout(autoTimer);
			window.clearTimeout(loadingTimer);
		};

		const answeredUpTo = () => {
			let count = 0;
			while (count < QUESTION_COUNT && answers[count + 1]) count++;
			return count;
		};

		/** Historiasta tuleva askel voi olla sellainen, johon ei ole vielä vastauksia. */
		const clampStep = (target: number) => {
			const answered = answeredUpTo();
			if (answered < QUESTION_COUNT) return Math.min(target, answered + 1);
			return formSubmitted ? target : Math.min(target, STEP_EMAIL);
		};

		const showFieldError = (input: HTMLInputElement, invalid: boolean) => {
			input.setAttribute('aria-invalid', String(invalid));
			const error = root.querySelector<HTMLElement>(`#${input.getAttribute('aria-describedby')}`);
			if (error) error.hidden = !invalid;
		};

		const validateForm = () => {
			const emailOk = isValidEmail(emailInput.value);
			const companyOk = companyInput.value.trim().length > 0;
			showFieldError(emailInput, !emailOk);
			showFieldError(companyInput, !companyOk);
			if (!emailOk) emailInput.focus();
			else if (!companyOk) companyInput.focus();
			return emailOk && companyOk;
		};

		/** Lähetys ei jää odottamaan vastausta eikä virhe näy käyttäjälle: tulos näytetään aina. */
		const sendSubscription = () => {
			const key = scoreAnswers(answers);
			const email = emailInput.value.trim();
			const companyName = companyInput.value.trim();
			const sendKey = JSON.stringify([email, companyName, key]);
			if (sendKey === lastSent) return;
			lastSent = sendKey;

			const timestamp = new Date().toISOString();
			const setHidden = (name: string, value: string) => {
				(emailForm.elements.namedItem(name) as HTMLInputElement).value = value;
			};
			setHidden('world', WORLD_IDS[key]);
			setHidden('keyword', KEYWORDS[key]);
			setHidden('timestamp', timestamp);

			// Netlify Forms: vastaus tallentuu Netlifyyn, ja siitä tulee ilmoitus sähköpostiin.
			void fetch(FORM_URL, {
				method: 'POST',
				headers: {'Content-Type': 'application/x-www-form-urlencoded'},
				keepalive: true,
				body: new URLSearchParams(new FormData(emailForm) as unknown as Record<string, string>).toString(),
			}).catch(() => {});

			// Sähköpostityökalu: tekee mitään vasta, kun työkalu on kytketty, ks. src/lib/subscribe.ts.
			void fetch(SUBSCRIBE_URL, {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				keepalive: true,
				body: JSON.stringify({
					email,
					companyName,
					world: WORLD_IDS[key],
					keyword: KEYWORDS[key],
					timestamp,
					website: honeypotInput.value,
				}),
			}).catch(() => {});
		};

		const animateIn = (direction: number) => {
			if (reducedMotion.matches) return;
			stage.animate(
				[
					{opacity: 0, transform: `translateX(${18 * direction}px)`},
					{opacity: 1, transform: 'none'},
				],
				{duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)'},
			);
		};

		const resetViewport = () => {
			// Juuren oma yläpadding varaa tilan sivuston kiinteälle headerille.
			const top = root.getBoundingClientRect().top + window.scrollY;
			window.scrollTo({top: Math.max(0, top), behavior: 'instant'});
			stage.focus({preventScroll: true});
		};

		const syncSelection = () => {
			steps.forEach((section) => {
				const question = Number(section.dataset.step);
				const picked = answers[question];
				section.querySelector('[data-image-grid]')?.classList.toggle('has-pick', Boolean(picked));
				section.querySelectorAll<HTMLElement>('[data-pick]').forEach((button) => {
					button.setAttribute('aria-pressed', String(button.dataset.pick === picked));
				});
			});
		};

		const preloadImages = () => {
			root
				.querySelectorAll<HTMLImageElement>(`[data-step="${IMAGE_QUESTION}"] img`)
				.forEach((image) => {
					image.loading = 'eager';
				});
		};

		/** Värilaatan nimi luetaan vaaleana tummalta pohjalta ja tummana vaalealta. */
		const isDark = (hex: string) => {
			const [r, g, b] = [1, 3, 5].map((index) => parseInt(hex.slice(index, index + 2), 16) / 255);
			return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.55;
		};

		const renderResult = () => {
			const key: StyleKey = scoreAnswers(answers);

			// Sama vastausyhdistelmä rakennetaan ja lasketaan vain kerran, vaikka selaimessa palattaisiin takaisin.
			const answerKey = JSON.stringify(answers);
			if (trackedResult !== answerKey) {
				trackedResult = answerKey;

				const result = RESULTS[key];
				const setText = (selector: string, text: string) => {
					root.querySelector<HTMLElement>(selector)!.textContent = text;
				};
				setText('[data-world]', result.world);
				setText('[data-tagline]', result.tagline);
				setText('[data-impression]', result.impression);
				setText('[data-palette-note]', result.paletteNote);
				setText('[data-typography]', result.typography);
				setText('[data-shapes]', result.shapes);
				setText('[data-images]', result.images);
				setText('[data-try]', result.tryThis);

				root.querySelector<HTMLElement>('[data-swatches]')!.replaceChildren(
					...result.palette.map(({name, hex}) => {
						const swatch = document.createElement('div');
						swatch.className = 'tyylitesti__swatch';
						swatch.style.background = hex;
						swatch.classList.toggle('is-dark', isDark(hex));
						const label = document.createElement('span');
						label.textContent = name;
						swatch.append(label);
						return swatch;
					}),
				);
				root.querySelector<HTMLElement>('[data-swatch-list]')!.replaceChildren(
					...result.palette.map(({name, description}) => {
						const item = document.createElement('li');
						const title = document.createElement('strong');
						title.textContent = name.replace(/\u00AD/g, '');
						item.append(title, ` – ${description}`);
						return item;
					}),
				);

				const w = window as unknown as {dataLayer?: unknown[]};
				w.dataLayer = w.dataLayer || [];
				w.dataLayer.push({event: 'tyylitesti_valmis', tyyli: key});
			}
		};

		const render = (direction: number) => {
			steps.forEach((section) => {
				section.hidden = Number(section.dataset.step) !== step;
			});

			const isQuestion = step >= 1 && step <= QUESTION_COUNT;
			progress.hidden = !isQuestion;
			root.classList.toggle('is-plain', step === STEP_EMAIL || step === STEP_RESULT);
			if (isQuestion) {
				progressLabel.textContent = `${step}/${QUESTION_COUNT}`;
				progressBar.setAttribute('aria-valuenow', String(step));
				progressFill.style.width = `${step * 20}%`;
			}
			if (step >= IMAGE_QUESTION - 1) preloadImages();

			syncSelection();
			if (step === STEP_RESULT) renderResult();
			if (step === STEP_LOADING) {
				loadingTimer = window.setTimeout(
					() => {
						step = STEP_RESULT;
						// Latausnäkymää ei jätetä historiaan, jotta takaisin vie lomakkeeseen.
						history.replaceState({tyylitestiStep: step}, '');
						render(1);
					},
					reducedMotion.matches ? LOADING_MS_REDUCED : LOADING_MS,
				);
			}

			resetViewport();
			animateIn(direction);
		};

		const go = (next: number) => {
			clearTimers();
			const direction = next >= step ? 1 : -1;
			step = next;
			history.pushState({tyylitestiStep: step}, '');
			render(direction);
		};

		root.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;

			const pick = target.closest<HTMLElement>('[data-pick]');
			if (pick) {
				const question = step;
				if (answers[question] !== pick.dataset.pick) formSubmitted = false;
				answers[question] = pick.dataset.pick as StyleKey;
				syncSelection();
				window.clearTimeout(autoTimer);
				autoTimer = window.setTimeout(() => {
					if (step === question) go(question + 1);
				}, AUTO_ADVANCE_MS);
				return;
			}

			if (target.closest('[data-start]')) go(1);
			else if (target.closest('[data-back]')) {
				clearTimers();
				history.back();
			}
		});

		emailForm.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!validateForm()) return;
			formSubmitted = true;
			sendSubscription();
			go(STEP_LOADING);
		});

		// Virhe poistuu heti, kun kenttä on korjattu.
		emailInput.addEventListener('input', () => {
			if (emailInput.getAttribute('aria-invalid') === 'true' && isValidEmail(emailInput.value)) {
				showFieldError(emailInput, false);
			}
		});
		companyInput.addEventListener('input', () => {
			if (companyInput.getAttribute('aria-invalid') === 'true' && companyInput.value.trim()) {
				showFieldError(companyInput, false);
			}
		});

		window.addEventListener('popstate', (event) => {
			const requested = (event.state as {tyylitestiStep?: number} | null)?.tyylitestiStep ?? STEP_INTRO;
			const next = clampStep(requested);
			const direction = next >= step ? 1 : -1;
			clearTimers();
			step = next;
			if (next !== requested) history.replaceState({tyylitestiStep: step}, '');
			render(direction);
		});

		history.replaceState({tyylitestiStep: STEP_INTRO}, '');
	}
</script>
